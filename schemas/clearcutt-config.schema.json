{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clearcutt.dev/schemas/clearcutt-config.schema.json",
  "title": "ClearCutt Fleet Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "registry",
    "matrix",
    "catalog",
    "remediation"
  ],
  "properties": {
    "apiVersion": {
      "const": "clearcutt.dev/v1"
    },
    "kind": {
      "enum": [
        "ClearCuttConfig",
        "FleetConfig"
      ],
      "description": "ClearCuttConfig is current; FleetConfig is the legacy value, still accepted so existing forks load unchanged."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "repository",
        "imagePrefix"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "imagePrefix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productName",
        "vendor",
        "authors"
      ],
      "properties": {
        "productName": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "pages": {
          "type": "boolean"
        },
        "basePath": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systems",
        "languages",
        "tiers"
      ],
      "properties": {
        "systems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "x86_64-linux",
              "aarch64-linux"
            ]
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "description": "Legacy explicit form: a runtime line id such as java21 or coreLTS.",
                "type": "string",
                "minLength": 1
              },
              {
                "description": "Language-level form: a language plus a release channel, resolved to runtime lines via the version policy.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "language",
                  "channel"
                ],
                "properties": {
                  "language": {
                    "type": "string",
                    "minLength": 1
                  },
                  "channel": {
                    "enum": [
                      "lts",
                      "current",
                      "preview",
                      "experimental"
                    ]
                  }
                }
              }
            ]
          }
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "dev",
              "slim",
              "distroless"
            ]
          }
        },
        "preview": {
          "description": "Persistent opt-in to preview-channel runtimes for the language-level form; overridable per run by clearcutt-verify fleet compile --allow-preview.",
          "type": "boolean"
        }
      }
    },
    "rebase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflowIdentity": {
          "type": "string"
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseLimit",
        "scanDepth",
        "scanAll"
      ],
      "properties": {
        "releaseLimit": {
          "type": "integer",
          "minimum": 1
        },
        "scanDepth": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "scanAll": {
          "type": "boolean"
        }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "productionTiers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "slim",
                  "distroless"
                ]
              }
            },
            "minimumSeverity": {
              "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "negligible",
                "unknown"
              ]
            },
            "reachability": {
              "description": "Closure-presence reachability gate: runtime (only findings in the shipped runtime closure) or any. Not exploitability/call-graph reachability.",
              "enum": [
                "runtime",
                "any"
              ]
            },
            "epssPercentile": {
              "description": "FIRST EPSS percentile (0-1) at/above which a finding is materially risky. Missing EPSS falls back to KEV/severity.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "kev": {
              "description": "CISA KEV handling: always (a KEV finding is always in scope) or off.",
              "enum": [
                "always",
                "off"
              ]
            },
            "requireFixedVersion": {
              "description": "true (default): an in-scope finding with no upstream fix blocks until acknowledged. false: it auto-accepts as an expiring record (escape hatch for unbackported CVEs). KEV is non-loosenable either way.",
              "type": "boolean"
            },
            "acceptedExpiryDays": {
              "description": "Backstop expiry (days) for auto-recorded acceptances, which re-evaluate each scan.",
              "type": "integer",
              "minimum": 0
            },
            "preferSubstitutable": {
              "description": "Break triage route-recommendation ties in favor of a substitutable (cache-served) fix over a rebuild when both carry the fix. Default true.",
              "type": "boolean"
            },
            "waitMaxSeverity": {
              "description": "Ceiling at/below which triage may offer the wait route (fix merged upstream but not yet on a cached ref). A finding above the ceiling never gets a bare wait. Default medium.",
              "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "negligible",
                "unknown"
              ]
            },
            "waitMaxDays": {
              "description": "Backstop expiry (days) for wait decisions: a wait retires at min(watched ref carries the fix, this many days). Default 30; an explicit 0 makes every wait expire immediately (must be re-decided each sweep).",
              "type": "integer",
              "minimum": 0
            },
            "requireRuntimeLayer": {
              "description": "Deprecated: use reachability. true maps to reachability=runtime, false to any.",
              "type": "boolean"
            },
            "epssPercentileBoostAt": {
              "description": "Deprecated: use epssPercentile.",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "kevBoost": {
              "description": "Deprecated: use kev. true maps to kev=always, false to off.",
              "type": "boolean"
            }
          }
        }
      }
    },
    "runtimeLines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "language",
          "version",
          "packageCandidates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "appTemplateRuntime": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "packageCandidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "devPackages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "omitInProduction": {
            "type": "boolean"
          },
          "smoke": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "template",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "template": {
            "enum": [
              "postgres",
              "valkey",
              "oauth2-proxy"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "packageCandidates": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "protocol": {
                  "enum": [
                    "tcp",
                    "udp"
                  ]
                }
              }
            }
          },
          "stateful": {
            "type": "boolean"
          },
          "dataDirs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entrypoint": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cmd": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "smoke": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lifecycle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "preview",
                  "active",
                  "deprecated",
                  "experimental",
                  "eol",
                  "blocked"
                ]
              },
              "support": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "productionAllowed": {
            "type": "boolean"
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "release": {
      "type": "object",
      "deprecated": true,
      "description": "Ignored. Retained so an existing config still validates; ClearCutt no longer builds or releases images."
    },
    "admission": {
      "type": "object",
      "deprecated": true,
      "description": "Ignored. Retained so an existing config still validates; admission policy is generated from flags."
    },
    "templates": {
      "type": "object",
      "deprecated": true,
      "description": "Ignored. Retained so an existing config still validates; app templates were removed with the image factory."
    }
  }
}
