---
import type { CatalogIndex } from '../lib/catalog-schema';
import LangIcon from './LangIcon.astro';
import { loadSiteConfig, tierLabel } from '../lib/site-config';
import { channelStatus, evidenceTextClass, evidenceTitle as evidenceStatusTitle, statusLabel } from '../lib/evidence-status';

interface Props { index: CatalogIndex }
const { index } = Astro.props;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const siteConfig = loadSiteConfig();

const tierOrder: Array<'distroless' | 'slim' | 'dev'> = ['distroless', 'slim', 'dev'];

const runtimeImages = index.images.filter((img) => (img.kind ?? 'runtime') === 'runtime' && img.tier !== 'service');
const byId = new Map(runtimeImages.map((img) => [img.id, img]));

const LANGUAGE_ORDER = ['core', 'java', 'node', 'python', 'go', 'dotnet', 'rust', 'cc'];

// Per-language source-of-truth lines for built-ins. Custom runtime lines
// generated by `clearcutt-verify runtime scaffold` link to runtime-extensions.nix.
const REGISTRY_LINES: Record<string, number> = {
  core:   40,
  java:   49,
  node:   66,
  python: 81,
  go:     96,
  dotnet: 111,
  rust:   142,
  cc:     152,
};
const BUILDER_LINE = 70; // core/lib/build-fleet.nix buildFleetImage entrypoint

function fallbackRuntimeKeyFor(langId: string, version: string): string {
  if (langId === 'core') return 'coreLTS';
  return `${langId}${version}`;
}
function runtimeKeyFromImage(img: CatalogIndex['images'][number]): string {
  const tierSuffix = `-${img.tier}`;
  if (img.id.endsWith(tierSuffix)) {
    return img.id.slice(0, -tierSuffix.length);
  }
  return fallbackRuntimeKeyFor(img.language, img.languageVersion);
}

const rowsByLanguage = new Map<string, { id: string; display: string; runtimeKeys: Map<string, string> }>();
for (const img of runtimeImages) {
  const existing = rowsByLanguage.get(img.language);
  if (existing) {
    if (!existing.runtimeKeys.has(img.languageVersion)) {
      existing.runtimeKeys.set(img.languageVersion, runtimeKeyFromImage(img));
    }
  } else {
    rowsByLanguage.set(img.language, {
      id: img.language,
      display: img.languageDisplay,
      runtimeKeys: new Map([[img.languageVersion, runtimeKeyFromImage(img)]]),
    });
  }
}

const LANG_ROWS = Array.from(rowsByLanguage.values())
  .map((row) => {
    const versions = Array.from(row.runtimeKeys.keys()).sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));
    const runtimeKeys = Object.fromEntries(
      versions.map((version) => [version, row.runtimeKeys.get(version) ?? fallbackRuntimeKeyFor(row.id, version)])
    );
    return {
      id: row.id,
      display: row.display,
      versions,
      runtimeKeys,
    };
  })
  .sort((a, b) => {
    const ai = LANGUAGE_ORDER.indexOf(a.id);
    const bi = LANGUAGE_ORDER.indexOf(b.id);
    if (ai >= 0 && bi >= 0) return ai - bi;
    if (ai >= 0) return -1;
    if (bi >= 0) return 1;
    return a.display.localeCompare(b.display);
  });

function registryPathFor(langId: string): string {
  return REGISTRY_LINES[langId] ? 'core/lib/registry.nix' : 'core/lib/runtime-extensions.nix';
}
function registryLabelFor(langId: string): string {
  const line = REGISTRY_LINES[langId];
  return line ? `registry.nix#L${line}` : 'runtime-extensions.nix';
}
function registryHrefFor(langId: string): string {
  const line = REGISTRY_LINES[langId];
  const anchor = line ? `#L${line}` : '';
  return `${index?.repoUrl}/blob/main/${registryPathFor(langId)}${anchor}`;
}

function slotState(img: ReturnType<typeof byId.get>) {
  if (!img) return 'pending' as const;
  if (img.latestTag === index.latestTag) return 'current' as const;
  return 'lagging' as const;
}
function runtimeKeyFor(row: typeof LANG_ROWS[number], version: string): string {
  return row.runtimeKeys[version] ?? fallbackRuntimeKeyFor(row.id, version);
}
function targetIdFor(runtimeKey: string, tier: string): string {
  return `${runtimeKey}-${tier}`;
}
function ociRepoFor(runtimeKey: string): string {
  return `clearcutt-${runtimeKey}`.toLowerCase();
}

type VulnSummary = {
  critical: number;
  high: number;
  medium: number;
  low: number;
  scannedAt: string | null;
  remediation?: {
    eligible: number;
    baseLayer: number;
    noFixedVersion: number;
    belowPriorityThreshold: number;
    otherDeferred: number;
  };
};
function vulnBadgeClass(v: VulnSummary | null | undefined): string {
  if (!v) return 'chip border-ink-700 text-ink-300';
  const eligible = v.remediation?.eligible ?? 0;
  const critical = v.critical ?? 0;
  const high = v.high ?? 0;
  const totalCritHigh = critical + high;
  
  if (eligible > 0) {
    if (v.critical > 0) return 'chip-danger';
    return 'chip-warn';
  }
  if (totalCritHigh > 0) {
    return 'chip border-emerald-800 bg-emerald-950/20 text-emerald-400 font-semibold';
  }
  return 'chip-accent';
}
function vulnBadgeLabel(v: VulnSummary | null | undefined): string {
  if (!v) return 'no scan';
  const eligible = v.remediation?.eligible ?? 0;
  const critical = v.critical ?? 0;
  const high = v.high ?? 0;
  const totalCritHigh = critical + high;
  if (eligible > 0) {
    return `${eligible} eligible fix${eligible > 1 ? 'es' : ''}`;
  }
  if (totalCritHigh > 0) {
    return 'VEX Triaged';
  }
  return '0 eligible';
}
function vulnBadgeTitle(v: VulnSummary | null | undefined): string {
  if (!v) return 'No vulnerability scan has been attached yet.';
  const r = v.remediation;
  if (!r) return 'Open the image page for runtime/base scope and fixed-version details.';
  const parts = [];
  if (r.eligible) parts.push(`${r.eligible} fix available`);
  if (r.noFixedVersion) parts.push(`${r.noFixedVersion} no fix found`);
  if (r.baseLayer) parts.push(`${r.baseLayer} base image`);
  if (r.belowPriorityThreshold) parts.push(`${r.belowPriorityThreshold} tracked lower severity`);
  if (r.otherDeferred) parts.push(`${r.otherDeferred} tracked`);
  return parts.length > 0
    ? `Critical/high fix status: ${parts.join(', ')}.`
    : 'No critical/high findings in this catalog scan.';
}
function isImportedImage(img: CatalogIndex['images'][number]): boolean {
  return Boolean(img.governance?.imported || img.origin?.kind === 'imported' || img.origin?.createdByClearCutt === false || img.origin?.provenanceClaim === 'none');
}
function tierDescription(tier: 'distroless' | 'slim' | 'dev'): string {
  switch (tier) {
    case 'distroless':
      return 'zero shells · hardened runtime';
    case 'slim':
      return 'runtime + minimal tooling';
    case 'dev':
      return 'build-time · do not deploy';
  }
}
function rowSlotSummary(row: typeof LANG_ROWS[number], version: string) {
  const summary = { current: 0, pending: 0, lagging: 0 };
  for (const tier of tierOrder) {
    const img = byId.get(targetIdFor(runtimeKeyFor(row, version), tier));
    summary[slotState(img)] += 1;
  }
  return {
    version,
    total: tierOrder.length,
    current: summary.current,
    pending: summary.pending,
    lagging: summary.lagging,
  };
}
function rowSlotSummaryText(summary: ReturnType<typeof rowSlotSummary>): string {
  const parts = [`${summary.current}/${summary.total} current`];
  if (summary.pending > 0) parts.push(`${summary.pending} pending`);
  if (summary.lagging > 0) parts.push(`${summary.lagging} lagging`);
  return parts.join(' / ');
}
---
<div class="surface overflow-hidden">
  <div class="hidden xl:block">
  <!-- Header row -->
  <div class="grid grid-cols-[minmax(180px,0.9fr)_repeat(3,minmax(260px,1fr))] border-b border-ink-700/70 bg-ink-900/60 text-xs uppercase tracking-wider text-ink-300">
    <div class="px-5 py-3">Language</div>
    {tierOrder.map((t) => (
      <div class="matrix-cell px-5 py-3 border-l border-ink-700/40" data-tier={t} data-state="header">
        <div class="text-ink-100">{tierLabel(siteConfig, t)}</div>
        <div class="mt-0.5 text-[10px] normal-case tracking-normal text-ink-300">
          {tierDescription(t)}
        </div>
      </div>
    ))}
  </div>

  {LANG_ROWS.map((row) => (
    <div class="grid grid-cols-[minmax(180px,0.9fr)_repeat(3,minmax(260px,1fr))] border-b border-ink-800 last:border-b-0" data-matrix-row data-desktop-matrix-row>
      <div class="flex flex-col justify-between px-5 py-4 min-h-[140px] space-y-4">
        <div class="flex items-start gap-3">
          <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-ink-700/60 bg-ink-800/60 p-2">
            <LangIcon language={row.id} class="h-6 w-6" />
          </span>
          <div class="leading-tight">
            <div class="text-sm font-semibold text-ink-50">{row.display}</div>
            {row.versions.length > 1 ? (
              <div class="flex items-center rounded-lg bg-ink-950/80 p-0.5 border border-ink-700/40 text-[10px] w-fit mt-1.5" role="group" aria-label={`Select ${row.display} version`}>
                {row.versions.map((ver, idx) => {
                  const isNewest = idx === row.versions.length - 1;
                  return (
                    <button
                      type="button"
                      class="px-2 py-0.5 rounded font-mono transition text-ink-300 data-[active=true]:bg-accent/15 data-[active=true]:text-accent-soft data-[active=true]:font-semibold"
                      data-version-btn={ver}
                      data-runtime-key={runtimeKeyFor(row, ver)}
                      data-active={isNewest ? "true" : "false"}
                      aria-pressed={isNewest ? "true" : "false"}
                      aria-label={`Show ${row.display} ${ver}`}
                    >
                      {ver}
                    </button>
                  );
                })}
              </div>
            ) : (
              <div class="mt-1 flex flex-wrap gap-1.5">
                {row.versions.map((v) => (
                  <span class="chip text-[10px] text-ink-200">{v}</span>
                ))}
              </div>
            )}
          </div>
        </div>

        {/* Nix Blueprint Overlay Metadata */}
        <div class="pt-3 border-t border-ink-800/60 space-y-2 text-[10px] w-full font-sans select-none">
          <div class="text-[9px] uppercase tracking-wider text-ink-400 font-semibold">Nix Blueprint</div>
          <div class="space-y-1 font-mono text-[9.5px]">
            <div class="flex items-center justify-between text-ink-300">
              <span>Target:</span>
              <span class="text-accent-soft font-semibold" data-blueprint-target={row.id}>
                .{`#`}{runtimeKeyFor(row, row.versions[row.versions.length - 1])}-distroless
              </span>
            </div>
            <a
              href={registryHrefFor(row.id)}
              target="_blank"
              rel="noreferrer"
              class="flex items-center justify-between text-ink-300 hover:text-accent-soft group"
            >
              <span>Registry:</span>
              <span class="underline flex items-center gap-0.5 text-ink-100 group-hover:text-accent-soft font-sans">
                {registryLabelFor(row.id)}
                <svg viewBox="0 0 24 24" class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
              </span>
            </a>
            <a
              href={`${index?.repoUrl}/blob/main/core/lib/build-fleet.nix#L${BUILDER_LINE}`}
              target="_blank"
              rel="noreferrer"
              class="flex items-center justify-between text-ink-300 hover:text-accent-soft group"
            >
              <span>Nix Builder:</span>
              <span class="underline flex items-center gap-0.5 text-ink-100 group-hover:text-accent-soft font-sans">
                build-fleet.nix#L{BUILDER_LINE}
                <svg viewBox="0 0 24 24" class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
              </span>
            </a>
          </div>
        </div>
      </div>
      {tierOrder.map((tier) => (
        <div class="border-l border-ink-800/70 px-2 py-2 space-y-2">
          {row.versions.map((ver, idx) => {
            const runtimeKey = runtimeKeyFor(row, ver);
            const id = targetIdFor(runtimeKey, tier);
            const img = byId.get(id);
            const state = slotState(img);
            const repo = ociRepoFor(runtimeKey);
            const isNewest = idx === row.versions.length - 1;

            if (state === 'pending') {
              return (
                <div
                  class="matrix-cell rounded-md border border-dashed border-ink-700/60 px-3 py-2 opacity-60"
                  data-tier={tier}
                  data-state="pending"
                  data-vuln="none"
                  data-pagefind-ignore
                  data-version-block={ver}
                  data-active={isNewest ? "true" : "false"}
                  aria-hidden={isNewest ? "false" : "true"}
                  style={isNewest ? undefined : "display: none;"}
                >
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-mono text-[11px] text-ink-300 truncate">
                      {row.versions.length > 1 && <span class="text-ink-500">{ver}: </span>}
                      {repo}:{tier}
                    </span>
                    <span class="font-mono text-[9px] text-ink-300">—</span>
                  </div>
                  <div class="mt-1 text-[10px] text-ink-300">Not yet in {index.latestTag}</div>
                </div>
              );
            }

            const linkHref = `${base}images/${img!.id}`;
            const tagShown = img!.latestTag;
            const vs = img!.vulnSummary;
            const evidence = img!.evidence;
            const signatureEvidence = channelStatus(evidence, 'signature', img!.signed);
            const provenanceEvidence = channelStatus(evidence, 'provenance', img!.provenance);
            const sbomEvidence = channelStatus(evidence, 'sbom', evidence?.sbom);
            const scanEvidence = channelStatus(evidence, 'vulnerabilities', evidence?.vulnerabilities);
            const imported = isImportedImage(img!);
            const vulnBucket =
              !vs ? 'none' : vs.critical > 0 ? 'critical' : vs.high > 0 ? 'high' : 'clean';
            return (
              <a
                href={linkHref}
                class={`matrix-cell group block rounded-xl border border-ink-800 bg-ink-950/20 px-3.5 py-3 no-underline transition hover:border-accent/40 hover:bg-ink-950/60 hover:-translate-y-0.5 hover:scale-[1.01] hover:shadow-glow duration-300 space-y-3 ${state === 'lagging' ? 'opacity-70 bg-ink-800/10' : ''}`}
                data-tier={tier}
                data-state={state}
                data-vuln={vulnBucket}
                data-version-block={ver}
                data-active={isNewest ? "true" : "false"}
                aria-hidden={isNewest ? "false" : "true"}
                style={isNewest ? undefined : "display: none;"}
              >
                {/* Cell Header: Repo Name and Tag */}
                <div class="flex items-center justify-between gap-2 border-b border-ink-800/40 pb-2">
                  <div class="min-w-0 flex items-center gap-1">
                    {row.versions.length > 1 && (
                      <span class="shrink-0 font-mono text-[10px] font-bold text-accent-soft px-1 rounded bg-accent/10 border border-accent/20">{ver}</span>
                    )}
                    <span class="truncate font-mono text-[11px] font-semibold text-ink-100 group-hover:text-accent-soft">
                      {repo}
                    </span>
                    <span class="font-mono text-[9px] text-ink-400">:{tier}</span>
                    {imported && <span class="shrink-0 rounded border border-sky-500/30 bg-sky-500/10 px-1 py-0.5 text-[7.5px] font-bold uppercase tracking-wider text-sky-300">Imported image</span>}
                  </div>
                  <span class="shrink-0 font-mono text-[9px] text-ink-400 bg-ink-950/80 border border-ink-800/80 rounded px-1.5 py-0.5" title="Release tag">{tagShown}</span>
                </div>

                {/* Sub-row 1: Platforms and Attestations */}
                <div class="flex items-center justify-between gap-2 text-[10px]">
                  <!-- Architectures -->
                  <div class="flex items-center gap-1.5 text-ink-300 font-mono" title="Supported processor architectures">
                    <svg viewBox="0 0 24 24" class="h-3 w-3 text-ink-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18M3 9h18M3 15h18"/></svg>
                    <span>{img!.architectures.join(' · ')}</span>
                  </div>

                  <!-- Cryptographic Supply Chain locks -->
                  <div class="flex items-center gap-1 rounded bg-ink-950/50 border border-ink-800 px-1.5 py-0.5 shrink-0" title="Cryptographic Supply Chain Evidence: Signature, SLSA L3, SBOM">
                    <!-- Signature -->
                    <span class={`${evidenceTextClass(signatureEvidence.status)} flex items-center`} title={evidenceStatusTitle('Sigstore signature', signatureEvidence)}>
                      <svg viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3 shrink-0">
                        <path d="M8 0c-.26 0-.5.1-.68.27L1.83 5.75c-.2.2-.33.48-.33.78v4.54c0 .32.14.62.38.82l5.5 4.54c.18.15.4.23.62.23s.44-.08.62-.23l5.5-4.54c.24-.2.38-.5.38-.82V6.53c0-.3-.13-.58-.33-.78L8.68.27A.96.96 0 008 0zm2.7 5.7a.75.75 0 010 1.06l-3.5 3.5a.75.75 0 01-1.06 0l-1.5-1.5a.75.75 0 111.06-1.06L7 9.44l2.97-2.97a.75.75 0 011.06 0z"/>
                      </svg>
                    </span>
                    <!-- SLSA -->
                    <span class={`${evidenceTextClass(provenanceEvidence.status)} flex items-center border-l border-ink-800/80 pl-1`} title={evidenceStatusTitle('SLSA provenance', provenanceEvidence)}>
                      <svg viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3 shrink-0">
                        <path fill-rule="evenodd" d="M8 1a3.5 3.5 0 00-3.5 3.5V7A1.5 1.5 0 003 8.5v5A1.5 1.5 0 004.5 15h7a1.5 1.5 0 001.5-1.5v-5A1.5 1.5 0 0011.5 7V4.5A3.5 3.5 0 008 1zm2 6V4.5a2 2 0 10-4 0V7h4z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                    <!-- SBOM -->
                    <span class={`${evidenceTextClass(sbomEvidence.status)} flex items-center border-l border-ink-800/80 pl-1`} title={evidenceStatusTitle('SBOM', sbomEvidence)}>
                      <svg viewBox="0 0 16 16" fill="currentColor" class="w-3 h-3 shrink-0">
                        <path fill-rule="evenodd" d="M2.5 12a.75.75 0 01.75-.75h10a.75.75 0 010 1.5h-10a.75.75 0 01-.75-.75zm0-4a.75.75 0 01.75-.75h10a.75.75 0 010 1.5h-10a.75.75 0 01-.75-.75zm0-4a.75.75 0 01.75-.75h10a.75.75 0 010 1.5h-10a.75.75 0 01-.75-.75z" clip-rule="evenodd"/>
                      </svg>
                    </span>
                  </div>
                </div>

                {/* Sub-row 2: Security Gate and Package Count */}
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-1.5">
                    {vs && vs.critical === 0 && vs.high === 0 ? (
                      <span class="inline-flex items-center gap-1 text-[9px] font-semibold text-emerald-400 bg-emerald-950/20 border border-emerald-800/30 rounded px-1.5 py-0.5" title={vulnBadgeTitle(vs)}>
                        <svg viewBox="0 0 24 24" class="h-3 w-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                        No high/critical in current scan
                      </span>
                    ) : (
                      <span class={`${vulnBadgeClass(vs ?? null)} text-[9px] px-1.5 py-0.5`} title={vulnBadgeTitle(vs ?? null)}>
                        {vulnBadgeLabel(vs ?? null)}
                      </span>
                    )}
                  </div>
                  <span class="font-mono text-[10px] text-ink-300">{img!.latestPackageCount} pkgs</span>
                </div>

                {/* Sub-row 3: Compliance Alignment Tags */}
                <div class="flex flex-wrap items-center justify-between gap-1.5 pt-2 border-t border-ink-800/40">
                  <div class="flex flex-wrap gap-1">
                    {tier === 'distroless' && (
                      <span class="inline-flex items-center px-1.5 py-0.2 rounded bg-emerald-500/10 border border-emerald-500/20 text-[7.5px] font-bold text-emerald-400 tracking-wider">SHELL-FREE</span>
                    )}
                    {tier !== 'dev' && (
                      <span class="inline-flex items-center px-1.5 py-0.2 rounded bg-sky-500/10 border border-sky-500/20 text-[7.5px] font-bold text-sky-400 tracking-wider">EVIDENCE LISTED</span>
                    )}
                    {tier === 'dev' && (
                      <span class="inline-flex items-center px-1.5 py-0.2 rounded bg-amber-500/10 border border-amber-500/20 text-[7.5px] font-bold text-amber-400 tracking-wider">BUILD ONLY</span>
                    )}
                  </div>

                  {state === 'lagging' ? (
                    <span class="inline-flex items-center px-1.5 py-0.2 rounded bg-amber-500/10 border border-amber-500/20 text-[7.5px] font-bold text-amber-400 tracking-wider" title={`No clean SBOM in ${index.latestTag} yet. Showing data from ${tagShown}.`}>
                      STALE
                    </span>
                  ) : (
                    <span class={`inline-flex items-center gap-1 text-[7.5px] font-bold uppercase tracking-wider ${evidenceTextClass(scanEvidence.status)}`}>
                      <span class={`h-1.5 w-1.5 rounded-full ${scanEvidence.status === 'missing' ? 'bg-amber-400' : 'bg-emerald-400'} animate-pulse`} />
                      Vulnerability scan: {statusLabel(scanEvidence.status)}
                    </span>
                  )}
                </div>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  ))}
  </div>

  <div class="space-y-3 p-3 xl:hidden" data-pagefind-ignore>
    {LANG_ROWS.map((row) => {
      const mobileSummary = rowSlotSummary(row, row.versions[row.versions.length - 1] ?? '');
      return (
      <details class="mobile-language-disclosure rounded-lg border border-ink-800/70 bg-ink-950/20" data-matrix-row>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-3 p-4 transition hover:bg-ink-900/35">
          <div class="flex min-w-0 items-start gap-3">
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-ink-700/60 bg-ink-800/60 p-2">
              <LangIcon language={row.id} class="h-6 w-6" />
            </span>
            <div class="min-w-0">
              <h2 class="text-sm font-semibold text-ink-50">{row.display}</h2>
              <p class="mt-1 text-xs text-ink-300" data-mobile-slot-summary>
                {row.versions.length} version{row.versions.length === 1 ? '' : 's'} / {rowSlotSummaryText(mobileSummary)}
              </p>
            </div>
          </div>
          <div class="flex shrink-0 items-center gap-2">
            <span class="chip text-[10px] text-ink-200" data-mobile-version-summary>{mobileSummary.version}</span>
            <svg data-disclosure-icon viewBox="0 0 20 20" class="h-4 w-4 text-ink-300 transition-transform" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 8l5 5 5-5" />
            </svg>
          </div>
        </summary>

        <div class="border-t border-ink-800/60 p-4">
          {row.versions.length > 1 && (
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="text-[10px] font-semibold uppercase tracking-wider text-ink-400">Version</span>
              <div class="flex items-center rounded-lg border border-ink-700/40 bg-ink-950/80 p-0.5 text-[10px]" role="group" aria-label={`Select ${row.display} version`}>
                {row.versions.map((ver, idx) => {
                  const isNewest = idx === row.versions.length - 1;
                  return (
                    <button
                      type="button"
                      class="rounded px-2 py-1 font-mono text-ink-300 transition data-[active=true]:bg-accent/15 data-[active=true]:font-semibold data-[active=true]:text-accent-soft"
                      data-version-btn={ver}
                      data-runtime-key={runtimeKeyFor(row, ver)}
                      data-summary-version={ver}
                      data-summary-status={`${row.versions.length} version${row.versions.length === 1 ? '' : 's'} / ${rowSlotSummaryText(rowSlotSummary(row, ver))}`}
                      data-active={isNewest ? "true" : "false"}
                      aria-pressed={isNewest ? "true" : "false"}
                      aria-label={`Show ${row.display} ${ver}`}
                    >
                      {ver}
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          <div class="mt-3 rounded-md border border-ink-800/60 bg-ink-900/35 p-3 text-[10px]">
            <div class="mb-2 font-semibold uppercase tracking-wider text-ink-400">Nix Blueprint</div>
            <div class="space-y-1 font-mono text-[9.5px]">
              <div class="flex min-w-0 items-center justify-between gap-3 text-ink-300">
                <span class="shrink-0">Target:</span>
                <span class="min-w-0 break-all text-right font-semibold text-accent-soft" data-blueprint-target={row.id}>
                  .{`#`}{runtimeKeyFor(row, row.versions[row.versions.length - 1])}-distroless
                </span>
              </div>
              <a href={registryHrefFor(row.id)} target="_blank" rel="noreferrer" class="flex min-w-0 items-center justify-between gap-3 text-ink-300 hover:text-accent-soft">
                <span class="shrink-0">Registry:</span>
                <span class="min-w-0 break-all text-right underline">{registryLabelFor(row.id)}</span>
              </a>
            </div>
          </div>

          <div class="mt-4 space-y-3">
            {tierOrder.map((tier) => (
              <section class="rounded-lg border border-ink-800/70 bg-ink-950/25 p-3" data-mobile-tier-panel data-tier={tier}>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-100">{tierLabel(siteConfig, tier)}</h3>
                  <p class="mt-0.5 text-[10px] text-ink-300">{tierDescription(tier)}</p>
                </div>
              </div>

              <div class="mt-3 space-y-2">
                {row.versions.map((ver, idx) => {
                  const runtimeKey = runtimeKeyFor(row, ver);
                  const id = targetIdFor(runtimeKey, tier);
                  const img = byId.get(id);
                  const state = slotState(img);
                  const repo = ociRepoFor(runtimeKey);
                  const isNewest = idx === row.versions.length - 1;

                  if (state === 'pending') {
                    return (
                      <div
                        class="matrix-cell rounded-md border border-dashed border-ink-700/60 px-3 py-2 opacity-70"
                        data-tier={tier}
                        data-state="pending"
                        data-vuln="none"
                        data-pagefind-ignore
                        data-version-block={ver}
                        data-active={isNewest ? "true" : "false"}
                        aria-hidden={isNewest ? "false" : "true"}
                        style={isNewest ? undefined : "display: none;"}
                      >
                        <div class="flex min-w-0 items-center justify-between gap-2">
                          <span class="min-w-0 truncate font-mono text-[11px] text-ink-300">
                            {row.versions.length > 1 && <span class="text-ink-500">{ver}: </span>}
                            {repo}:{tier}
                          </span>
                          <span class="font-mono text-[9px] text-ink-300">pending</span>
                        </div>
                        <div class="mt-1 text-[10px] text-ink-300">Not yet in {index.latestTag}</div>
                      </div>
                    );
                  }

                  const vs = img!.vulnSummary;
                  const evidence = img!.evidence;
                  const signatureEvidence = channelStatus(evidence, 'signature', img!.signed);
                  const provenanceEvidence = channelStatus(evidence, 'provenance', img!.provenance);
                  const sbomEvidence = channelStatus(evidence, 'sbom', evidence?.sbom);
                  const scanEvidence = channelStatus(evidence, 'vulnerabilities', evidence?.vulnerabilities);
                  const imported = isImportedImage(img!);
                  const vulnBucket =
                    !vs ? 'none' : vs.critical > 0 ? 'critical' : vs.high > 0 ? 'high' : 'clean';
                  return (
                    <a
                      href={`${base}images/${img!.id}`}
                      class={`matrix-cell block rounded-lg border border-ink-800 bg-ink-950/30 p-3 no-underline transition hover:border-accent/40 ${state === 'lagging' ? 'opacity-75' : ''}`}
                      data-tier={tier}
                      data-state={state}
                      data-vuln={vulnBucket}
                      data-version-block={ver}
                      data-active={isNewest ? "true" : "false"}
                      aria-hidden={isNewest ? "false" : "true"}
                      style={isNewest ? undefined : "display: none;"}
                    >
                      <div class="flex min-w-0 items-start justify-between gap-2">
                        <div class="min-w-0">
                          <div class="flex min-w-0 items-center gap-1.5">
                            {row.versions.length > 1 && <span class="rounded border border-accent/20 bg-accent/10 px-1 font-mono text-[10px] font-bold text-accent-soft">{ver}</span>}
                            <span class="min-w-0 truncate font-mono text-[11px] font-semibold text-ink-100">{repo}</span>
                            <span class="shrink-0 font-mono text-[9px] text-ink-400">:{tier}</span>
                            {imported && <span class="shrink-0 rounded border border-sky-500/30 bg-sky-500/10 px-1 py-0.5 text-[7.5px] font-bold uppercase tracking-wider text-sky-300">Imported image</span>}
                          </div>
                          <p class="mt-1 font-mono text-[10px] text-ink-300">{img!.architectures.join(' · ')}</p>
                        </div>
                        <span class="shrink-0 rounded border border-ink-800/80 bg-ink-950/80 px-1.5 py-0.5 font-mono text-[9px] text-ink-400">{img!.latestTag}</span>
                      </div>

                      <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
                        {vs && vs.critical === 0 && vs.high === 0 ? (
                          <span class="inline-flex items-center gap-1 rounded border border-emerald-800/30 bg-emerald-950/20 px-1.5 py-0.5 text-[9px] font-semibold text-emerald-400" title={vulnBadgeTitle(vs)}>
                            <svg viewBox="0 0 24 24" class="h-3 w-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                            No high/critical in current scan
                          </span>
                        ) : (
                          <span class={`${vulnBadgeClass(vs ?? null)} text-[9px] px-1.5 py-0.5`} title={vulnBadgeTitle(vs ?? null)}>
                            {vulnBadgeLabel(vs ?? null)}
                          </span>
                        )}
                        <span class="font-mono text-[10px] text-ink-300">{img!.latestPackageCount} pkgs</span>
                      </div>

                      <div class="mt-3 flex flex-wrap items-center justify-between gap-2 border-t border-ink-800/40 pt-2">
                        <div class="flex items-center gap-1 rounded border border-ink-800 bg-ink-950/50 px-1.5 py-0.5" title="Signature, provenance, and SBOM evidence">
                          <span class={evidenceTextClass(signatureEvidence.status)} title={evidenceStatusTitle('Sigstore signature', signatureEvidence)}>sig</span>
                          <span class="text-ink-700">/</span>
                          <span class={evidenceTextClass(provenanceEvidence.status)} title={evidenceStatusTitle('SLSA provenance', provenanceEvidence)}>prov</span>
                          <span class="text-ink-700">/</span>
                          <span class={evidenceTextClass(sbomEvidence.status)} title={evidenceStatusTitle('SBOM', sbomEvidence)}>sbom</span>
                        </div>
                        {state === 'lagging' ? (
                          <span class="rounded border border-amber-500/20 bg-amber-500/10 px-1.5 py-0.5 text-[7.5px] font-bold uppercase tracking-wider text-amber-400" title={`No clean SBOM in ${index.latestTag} yet. Showing data from ${img!.latestTag}.`}>
                            Stale
                          </span>
                        ) : (
                          <span class={`text-[7.5px] font-bold uppercase tracking-wider ${evidenceTextClass(scanEvidence.status)}`}>Scan: {statusLabel(scanEvidence.status)}</span>
                        )}
                      </div>
                    </a>
                  );
                })}
              </div>
              </section>
            ))}
          </div>
        </div>
      </details>
      );
    })}
  </div>
</div>

<style>
  .mobile-language-disclosure > summary::-webkit-details-marker {
    display: none;
  }

  .mobile-language-disclosure[open] [data-disclosure-icon] {
    transform: rotate(180deg);
  }
</style>

<script is:inline>
  document.querySelectorAll('[data-version-btn]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      
      const parentRow = btn.closest('[data-matrix-row]');
      if (!parentRow) return;
      
      const selectedVer = btn.getAttribute('data-version-btn');
      const selectedRuntimeKey = btn.getAttribute('data-runtime-key');
      
      // Update buttons active states in this switcher
      parentRow.querySelectorAll('[data-version-btn]').forEach(b => {
        const isMatch = b.getAttribute('data-version-btn') === selectedVer;
        b.setAttribute('data-active', isMatch ? 'true' : 'false');
        b.setAttribute('aria-pressed', isMatch ? 'true' : 'false');
      });
      
      // Update blueprint target span
      parentRow.querySelectorAll('[data-blueprint-target]').forEach(targetSpan => {
        if (selectedRuntimeKey) targetSpan.textContent = `.#${selectedRuntimeKey}-distroless`;
      });
      parentRow.querySelectorAll('[data-mobile-version-summary]').forEach(targetSpan => {
        const summaryVersion = btn.getAttribute('data-summary-version');
        if (summaryVersion) targetSpan.textContent = summaryVersion;
      });
      parentRow.querySelectorAll('[data-mobile-slot-summary]').forEach(targetSpan => {
        const summaryStatus = btn.getAttribute('data-summary-status');
        if (summaryStatus) targetSpan.textContent = summaryStatus;
      });
      
      // Update blocks in this row
      parentRow.querySelectorAll('[data-version-block]').forEach(block => {
        const isMatch = block.getAttribute('data-version-block') === selectedVer;
        block.setAttribute('data-active', isMatch ? 'true' : 'false');
        block.setAttribute('aria-hidden', isMatch ? 'false' : 'true');
        if (isMatch) {
          block.style.display = '';
        } else {
          block.style.display = 'none';
        }
      });
      document.dispatchEvent(new Event('clearcutt:matrix-version-change'));
    });
  });
</script>
