---
import Tabs from './Tabs.astro';
import CopyBlock from './CopyBlock.astro';
import { getImageMetadata } from '../lib/image-metadata';
import type { ImageRecord, ReleaseEntry } from '../lib/catalog-schema';
import { loadSiteConfig, tierLabel } from '../lib/site-config';

interface Props {
  image: ImageRecord;
  release: ReleaseEntry;
  ownerRepo: string;
}
const { image, release } = Astro.props;
const siteConfig = loadSiteConfig();
const devLabel = tierLabel(siteConfig, 'dev');
const isService = image.kind === 'service';
const service = image.service;
const serviceTag = release.tag === 'preview' ? 'service' : `${release.tag}-service`;
const rolling = isService ? `${image.fullName}:service` : `${image.fullName}:${image.tier.id}`;
const versioned = isService ? `${image.fullName}:${serviceTag}` : `${image.fullName}:${release.tag}-${image.tier.id}`;
const servicePorts = service?.ports ?? [];
const serviceDataDirs = service?.dataDirs ?? [];
const serviceSmoke = service?.smoke ?? [];
const servicePortSummary = servicePorts.length > 0
  ? servicePorts.map((p) => `${p.name ? `${p.name}:` : ''}${p.port}/${p.protocol ?? 'tcp'}`).join(', ')
  : 'No exposed ports';
const serviceStorageSummary = service?.stateful
  ? (serviceDataDirs.length > 0 ? serviceDataDirs.join(', ') : 'stateful')
  : 'stateless';
const serviceSmokeSummary = service?.smokeStatus ?? (serviceSmoke.length > 0 ? 'configured' : 'pending');
const vulnTotals = release.architectures.reduce(
  (acc, arch) => {
    const counts = arch.vulnerabilities?.countsBySeverity;
    if (!counts) return acc;
    acc.scanned += 1;
    acc.critical += counts.critical ?? 0;
    acc.high += counts.high ?? 0;
    acc.medium += counts.medium ?? 0;
    return acc;
  },
  { scanned: 0, critical: 0, high: 0, medium: 0 },
);
const serviceVulnerabilitySummary = vulnTotals.scanned === 0
  ? 'scan pending'
  : `${vulnTotals.critical} critical / ${vulnTotals.high} high / ${vulnTotals.medium} medium`;
const metadata = isService
  ? {
      description: `${service?.template ?? image.imageName} ${service?.version ?? image.language.version} is a first-class ClearCutt service image built from a Nix package template. It is cataloged separately from runtime tiers and carries service metadata for ports, storage, lifecycle, and smoke checks.`,
      useCases: [
        'Running platform-owned backing services with the same catalog and evidence model as base images',
        'Testing service templates locally before release promotion',
        'Publishing reusable infrastructure images without requiring app teams to learn Nix',
      ],
      dockerfileExample: `FROM ${versioned}`,
      ubiExample: `# Service images are intended to run directly.\n# For custom applications, use clearcutt-verify app build/rebase instead.`,
      nixExample: `nix build github:${image.registry.replace('ghcr.io/', '')}/${release.tag}#${image.id}`,
      layeringExample: `# ${image.id} is exposed as a service package attr:\n# .#packages.x86_64-linux.${image.id}`,
    }
  : getImageMetadata(image.language.id, image.language.version, image.tier.id as 'dev' | 'slim' | 'distroless', image.fullName, release.tag);

const servicePortArgs = (service?.ports ?? []).map((p) => `  -p ${p.port}:${p.port} \\`).join('\n');
const serviceVolumeArgs = (service?.dataDirs ?? []).map((dir, idx) => `  -v ${image.id}-data-${idx + 1}:${dir} \\`).join('\n');
const serviceCli = `clearcutt-verify service explain ${image.id}
clearcutt-verify service validate ${image.id}
clearcutt-verify service smoke ${image.id} --engine docker --image ${versioned}`;
const serviceAdvanced = `# Service package attr exposed by the ClearCutt flake.
nix build github:${image.registry.replace('ghcr.io/', '')}/${release.tag}#${image.id}

# Catalog service records are emitted when generation includes services.
clearcutt-verify catalog generate --config clearcutt.fleet.yaml --include-services --output dist/catalog`;

const dockerRun = isService ? `docker run --rm \\
  --user 10001:10001 \\
${servicePortArgs ? `${servicePortArgs}\n` : ''}${serviceVolumeArgs ? `${serviceVolumeArgs}\n` : ''}  ${versioned}` : `docker run --rm \\
  --read-only \\
  --cap-drop=ALL \\
  --security-opt no-new-privileges \\
  --user 10001:10001 \\
  --tmpfs /tmp:mode=1777 \\
  ${versioned}`;

const podmanRun = isService ? `podman run --rm \\
  --user 10001:10001 \\
${servicePortArgs ? `${servicePortArgs}\n` : ''}${serviceVolumeArgs ? `${serviceVolumeArgs}\n` : ''}  ${versioned}` : `podman run --rm \\
  --read-only \\
  --cap-drop=ALL \\
  --security-opt no-new-privileges \\
  --user 10001:10001 \\
  --tmpfs /tmp:mode=1777 \\
  ${versioned}`;

const serviceComposePorts = (service?.ports ?? []).map((p) => `      - "${p.port}:${p.port}"`).join('\n');
const serviceComposeVolumes = (service?.dataDirs ?? []).map((dir, idx) => `      - ${image.id}-data-${idx + 1}:${dir}`).join('\n');
const serviceTopLevelVolumes = (service?.dataDirs ?? []).map((_, idx) => `  ${image.id}-data-${idx + 1}: {}`).join('\n');
const compose = isService ? `services:
  ${image.id}:
    image: ${versioned}
    user: "10001:10001"
${serviceComposePorts ? `    ports:\n${serviceComposePorts}\n` : ''}${serviceComposeVolumes ? `    volumes:\n${serviceComposeVolumes}\n` : ''}${serviceTopLevelVolumes ? `volumes:\n${serviceTopLevelVolumes}` : ''}` : `services:
  app:
    image: ${versioned}
    read_only: true
    user: "10001:10001"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    tmpfs:
      - /tmp:mode=1777`;

const serviceContainerPorts = (service?.ports ?? []).map((p) => `        - containerPort: ${p.port}`).join('\n');
const serviceVolumeMounts = (service?.dataDirs ?? []).map((dir, idx) => `        - { name: data-${idx + 1}, mountPath: ${dir} }`).join('\n');
const serviceVolumes = (service?.dataDirs ?? []).map((_, idx) => `    - { name: data-${idx + 1}, emptyDir: {} }`).join('\n');
const kube = isService ? `apiVersion: v1
kind: Pod
metadata:
  name: ${image.id}
spec:
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 10001
    runAsGroup: 10001
  containers:
    - name: ${image.id}
      image: ${versioned}
${serviceContainerPorts ? `      ports:\n${serviceContainerPorts}\n` : ''}${serviceVolumeMounts ? `      volumeMounts:\n${serviceVolumeMounts}\n` : ''}${serviceVolumes ? `  volumes:\n${serviceVolumes}` : ''}` : `apiVersion: v1
kind: Pod
metadata:
  name: ${image.imageName}
spec:
  automountServiceAccountToken: false
  securityContext:
    runAsNonRoot: true
    runAsUser: 10001
    runAsGroup: 10001
    seccompProfile: { type: RuntimeDefault }
  containers:
    - name: app
      image: ${versioned}
      imagePullPolicy: IfNotPresent
      securityContext:
        readOnlyRootFilesystem: true
        allowPrivilegeEscalation: false
        capabilities: { drop: ["ALL"] }
      volumeMounts:
        - { name: tmp, mountPath: /tmp }
  volumes:
    - { name: tmp, emptyDir: { medium: Memory } }`;

// Nix overlay attribute names follow PascalCase + no-dot pattern
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const nixAttr =
  image.language.id === 'core'
    ? 'clearcuttCore'
    : `clearcutt${cap(image.language.id)}${image.language.version.replace(/\./g, '')}`;

const nixFlake = `{
  inputs.clearcutt.url = "github:${image.registry.replace('ghcr.io/', '')}/${release.tag}?dir=core";
  outputs = { self, nixpkgs, clearcutt }: {
    ${isService ? `packages.x86_64-linux.${image.id} = clearcutt.packages.x86_64-linux.${image.id};` : `devShells.x86_64-linux.default = let
      pkgs = import nixpkgs {
        system = "x86_64-linux";
        overlays = [ clearcutt.overlays.default ];
      };
    in pkgs.mkShell {
      buildInputs = [ pkgs.${nixAttr} ];
    };`}
  };
}`;
---
{isService ? (
<section class="space-y-4">
  <header class="flex items-center gap-4">
    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent/20 text-accent-soft border border-accent/40 font-mono text-base font-bold shadow-sm shadow-accent/10 select-none">
      1
    </span>
    <div>
      <h2 class="heading text-xl sm:text-2xl font-bold">Service Image Usage</h2>
      <p class="text-xs sm:text-sm text-ink-300">Run the platform service, inspect its operational contract, and verify the evidence attached to this release.</p>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-7 space-y-6">
      <div class="surface border border-ink-800 bg-ink-950/20 backdrop-blur-md rounded-2xl shadow-xl shadow-ink-950/50 p-6 space-y-5">
        <div>
          <h3 class="text-xs uppercase tracking-wider text-accent-soft font-bold mb-2">Service Contract</h3>
          <p class="text-sm text-ink-200 leading-relaxed">
            {service?.template ?? image.imageName} {service?.version ?? image.language.version} is a platform-owned service image. It is built from the fleet service template, cataloged separately from runtime tiers, and carries ports, storage, lifecycle, smoke, vulnerability, and evidence metadata.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
          <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
            <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Template</span>
            <span class="text-ink-100 font-mono">{service?.template ?? 'service'} {service?.version ?? image.language.version}</span>
          </div>
          <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
            <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Lifecycle</span>
            <span class={release.lifecycle.productionAllowed ? "text-emerald-400 font-semibold" : "text-amber-400 font-semibold"}>
              {release.lifecycle.status} / {release.lifecycle.productionAllowed ? 'production allowed' : 'non-production'}
            </span>
          </div>
          <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
            <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Ports</span>
            <span class="text-ink-100 font-mono">{servicePortSummary}</span>
          </div>
          <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
            <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Storage</span>
            <span class="text-ink-100 font-mono">{serviceStorageSummary}</span>
          </div>
          <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
            <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Entrypoint</span>
            <span class="text-ink-100 font-mono">{release.runtimeContract.defaultEntrypoint ?? 'image default'}</span>
          </div>
          <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
            <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Runtime User</span>
            <span class="text-emerald-400 font-semibold">{release.runtimeContract.user ? `UID ${release.runtimeContract.user}` : 'Rootless'}</span>
          </div>
          <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
            <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Smoke</span>
            <span class={serviceSmokeSummary === 'passed' ? "text-emerald-400 font-semibold" : "text-amber-400 font-semibold"}>{serviceSmokeSummary}</span>
          </div>
          <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
            <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Vulnerabilities</span>
            <span class={(vulnTotals.critical + vulnTotals.high) === 0 && vulnTotals.scanned > 0 ? "text-emerald-400 font-semibold" : "text-amber-400 font-semibold"}>{serviceVulnerabilitySummary}</span>
          </div>
        </div>

        {serviceSmoke.length > 0 && (
          <div class="border-t border-ink-800/50 pt-4">
            <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold mb-2.5">Configured Smoke Commands</h3>
            <ul class="space-y-2">
              {serviceSmoke.map((smoke) => (
                <li class="rounded-lg border border-ink-800/60 bg-ink-950/40 px-3 py-2 font-mono text-xs text-ink-100">{smoke}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <div class="lg:col-span-5">
      <div class="space-y-3">
        <div>
          <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold mb-1">Pull &amp; Run Service</h3>
          <p class="text-xs text-ink-400">Use digest-pinned pulls when available; mount volumes for stateful data dirs.</p>
        </div>

        <Tabs name={`service-usage-${image.id}`} tabs={[
          { id: 'docker', label: 'Docker' },
          { id: 'podman', label: 'Podman' },
          { id: 'compose', label: 'Compose' },
          { id: 'k8s', label: 'Kubernetes' },
          { id: 'cli', label: 'CLI' },
          { id: 'advanced', label: 'Advanced' },
        ]}>
          <div data-panel-id="docker" data-panel-active="true" class="space-y-4">
            {release.manifestDigest && (
              <div>
                <h3 class="mb-1 text-[10px] uppercase tracking-wider text-accent-soft font-bold font-mono">Pull by multi-arch digest</h3>
                <CopyBlock language="shell" code={`docker pull ${image.fullName}@${release.manifestDigest}`} />
              </div>
            )}
            <div>
              <h3 class="mb-1 text-[10px] uppercase tracking-wider text-ink-400 font-bold font-mono">Pinned service tag</h3>
              <CopyBlock language="shell" code={`docker pull ${versioned}`} />
            </div>
            <div>
              <h3 class="mb-1 text-[10px] uppercase tracking-wider text-ink-400 font-bold font-mono">Run service</h3>
              <CopyBlock language="shell" code={dockerRun} />
            </div>
          </div>

          <div data-panel-id="podman" data-panel-active="false" class="space-y-4">
            {release.manifestDigest && (
              <div>
                <h3 class="mb-1 text-[10px] uppercase tracking-wider text-accent-soft font-bold font-mono">Pull by multi-arch digest</h3>
                <CopyBlock language="shell" code={`podman pull ${image.fullName}@${release.manifestDigest}`} />
              </div>
            )}
            <div>
              <h3 class="mb-1 text-[10px] uppercase tracking-wider text-ink-400 font-bold font-mono">Pinned service tag</h3>
              <CopyBlock language="shell" code={`podman pull ${versioned}`} />
            </div>
            <div>
              <h3 class="mb-1 text-[10px] uppercase tracking-wider text-ink-400 font-bold font-mono">Run service</h3>
              <CopyBlock language="shell" code={podmanRun} />
            </div>
          </div>

          <div data-panel-id="compose" data-panel-active="false">
            <CopyBlock language="yaml" code={compose} label="docker-compose.yml" />
          </div>

          <div data-panel-id="k8s" data-panel-active="false">
            <CopyBlock language="yaml" code={kube} label="pod.yaml" />
          </div>

          <div data-panel-id="cli" data-panel-active="false">
            <CopyBlock language="shell" code={serviceCli} label="service-ops.sh" />
          </div>

          <div data-panel-id="advanced" data-panel-active="false">
            <CopyBlock language="shell" code={serviceAdvanced} label="service-provenance.sh" />
          </div>
        </Tabs>
      </div>
    </div>
  </div>
</section>
) : (
<section class="space-y-4">
  <header class="flex items-center gap-4">
    <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-accent/20 text-accent-soft border border-accent/40 font-mono text-base font-bold shadow-sm shadow-accent/10 select-none">
      1
    </span>
    <div>
      <h2 class="heading text-xl sm:text-2xl font-bold">About this Image &amp; Usage</h2>
      <p class="text-xs sm:text-sm text-ink-300">Explore container capabilities, common use cases, and integration blueprints.</p>
    </div>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    {/* Left Column: About this Image & Integration Blueprints (Col 1-7) */}
    <div class="lg:col-span-7 space-y-6 flex flex-col justify-between">
      {/* Visual Description & Use Cases Card */}
      <div class="surface border border-ink-800 bg-ink-950/20 backdrop-blur-md rounded-2xl shadow-xl shadow-ink-950/50 p-6 space-y-4 flex-1">
        <div>
          <h3 class="text-xs uppercase tracking-wider text-accent-soft font-bold mb-2">Capabilities &amp; Guarantees</h3>
          <p class="text-sm text-ink-200 leading-relaxed">{metadata.description}</p>
        </div>
        
        <div class="border-t border-ink-800/50 pt-4">
          <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold mb-2.5">Common Use Cases</h3>
          <ul class="space-y-2">
            {metadata.useCases.map((useCase) => (
              <li class="flex items-start gap-2.5 text-xs text-ink-200">
                <svg class="w-4 h-4 shrink-0 text-accent-soft mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.237-.1 2.45-.295 3.636M18.364 18.364A9 9 0 003.364 3.364m15 15A9 9 0 013.364 3.364m0 0a9 9 0 0115 0" />
                </svg>
                <span>{useCase}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="border-t border-ink-800/50 pt-4 space-y-3">
          <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold mb-2.5">Runtime Security &amp; Execution Contract</h3>
          <div class="grid grid-cols-2 gap-3 text-xs">
            <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
              <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Shell Presence</span>
              <span class={release.runtimeContract.shellPresent ? "text-amber-400 font-semibold" : "text-emerald-400 font-semibold"}>
                {release.runtimeContract.shellPresent ? "Yes (BusyBox/Bash)" : "No (Shell-Free)"}
              </span>
            </div>
            <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
              <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Package Manager</span>
              <span class={release.runtimeContract.packageManagerPresent ? "text-amber-400 font-semibold" : "text-emerald-400 font-semibold"}>
                {release.runtimeContract.packageManagerPresent ? "Yes (Active)" : "No (Absent)"}
              </span>
            </div>
            <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
              <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Secure UID Operator</span>
              <span class="text-emerald-400 font-semibold">
                {release.runtimeContract.user ? `UID ${release.runtimeContract.user}` : "Rootless"}
              </span>
            </div>
            <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
              <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Production Tier</span>
              <span class={release.runtimeContract.productionTier ? "text-emerald-400 font-semibold" : "text-amber-400 font-semibold"}>
                {release.runtimeContract.productionTier ? "Yes (Allowed)" : `No (${devLabel})`}
              </span>
            </div>
            <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
              <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">CA Certificates</span>
              <span class={release.runtimeContract.caCertificatesPresent ? "text-emerald-400 font-semibold" : "text-amber-400 font-semibold"}>
                {release.runtimeContract.caCertificatesPresent ? "Present / Active" : "Absent"}
              </span>
            </div>
            <div class="rounded-xl border border-ink-800/60 bg-ink-950/40 p-3 space-y-1">
              <span class="text-ink-400 block text-[9px] uppercase font-bold font-mono tracking-wider">Timezone Data</span>
              <span class={release.runtimeContract.timezoneDataPresent ? "text-emerald-400 font-semibold" : "text-amber-400 font-semibold"}>
                {release.runtimeContract.timezoneDataPresent ? "Present / Active" : "Absent"}
              </span>
            </div>
          </div>
        </div>
      </div>

      {/* Code Blueprints Tabs */}
      <div class="space-y-3 mt-4">
        <div>
          <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold mb-1">Developer blueprints</h3>
          <p class="text-xs text-ink-400">Copy pre-configured code structures to accelerate deployment pipelines.</p>
        </div>
        
        <Tabs name={`blueprints-${image.id}`} tabs={[
          { id: 'dockerfile', label: 'Dockerfile' },
          { id: 'base-overlay', label: 'Base Image Layering' },
          { id: 'nix-shell', label: 'Nix Shell' },
          { id: 'nix-layering', label: 'Nix Layering' }
        ]}>
          <div data-panel-id="dockerfile" data-panel-active="true">
            <CopyBlock language="dockerfile" code={metadata.dockerfileExample} label="Dockerfile" />
          </div>
          <div data-panel-id="base-overlay" data-panel-active="false" class="space-y-3">
            <p class="text-xs text-ink-300 leading-relaxed">
              If your organization mandates a certified base OS (like Red Hat UBI, Amazon Linux, or Ubuntu Pro) for compliance, you can stack ClearCutt's RPATH-bound <code class="font-mono text-accent-soft">/nix/store</code> closure directly on top without modifying base layers or bundled agents.
            </p>
            <CopyBlock language="nix" code={metadata.ubiExample} label="flake.overlay.nix" />
          </div>
          <div data-panel-id="nix-shell" data-panel-active="false">
            <CopyBlock language="nix" code={metadata.nixExample} label="flake.nix" />
          </div>
          <div data-panel-id="nix-layering" data-panel-active="false">
            <CopyBlock language="nix" code={metadata.layeringExample} label="layer.nix" />
          </div>
        </Tabs>
      </div>
    </div>

    {/* Right Column: Pull & Run Workspace (Col 8-12) */}
    <div class="lg:col-span-5 flex flex-col justify-between">
      <div class="space-y-3">
        <div>
          <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold mb-1">Pull &amp; Run Workspace</h3>
          <p class="text-xs text-ink-400">Select your preferred container engine or deployment platform target.</p>
        </div>
        
        <Tabs name={`usage-${image.id}`} tabs={[
          { id: 'docker', label: 'Docker' },
          { id: 'podman', label: 'Podman' },
          { id: 'compose', label: 'Compose' },
          { id: 'k8s', label: 'Kubernetes' },
          { id: 'nix', label: 'Nix Flake' },
        ]}>
          <div data-panel-id="docker" data-panel-active="true" class="space-y-4">
            {release.manifestDigest ? (
              <div>
                <h3 class="mb-1 text-[10px] uppercase tracking-wider text-accent-soft font-bold font-mono">Pull by multi-arch digest (Recommended, Secure)</h3>
                <CopyBlock language="shell" code={`docker pull ${image.fullName}@${release.manifestDigest}`} />
              </div>
            ) : (
              <div class="p-3.5 rounded-xl border border-amber-500/30 bg-amber-500/10 text-amber-300 text-xs space-y-1">
                <div class="flex items-center gap-1.5 font-bold uppercase tracking-wider text-[10px] text-amber-400">
                  <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  <span>Security Advisory: Missing Cryptographic Digest</span>
                </div>
                <p class="leading-relaxed">This release is missing a canonical multi-architecture manifest digest. Falling back to tag-pinned reference; please note tags are mutable and do not guarantee build immutability.</p>
              </div>
            )}
            <div>
              <h3 class="mb-1 text-[10px] uppercase tracking-wider text-ink-400 font-bold font-mono">Pinned to release</h3>
              <CopyBlock language="shell" code={`docker pull ${versioned}`} />
            </div>
            <div>
              <h3 class="mb-1 text-[10px] uppercase tracking-wider text-ink-400 font-bold font-mono">Quick pull (rolling)</h3>
              <CopyBlock language="shell" code={`docker pull ${rolling}`} />
            </div>
            <div>
              <h3 class="mb-1 text-[10px] uppercase tracking-wider text-ink-400 font-bold font-mono">Hardened docker run</h3>
              <CopyBlock language="shell" code={dockerRun} />
            </div>
          </div>

          <div data-panel-id="podman" data-panel-active="false" class="space-y-4">
            {release.manifestDigest ? (
              <div>
                <h3 class="mb-1 text-[10px] uppercase tracking-wider text-accent-soft font-bold font-mono">Pull by multi-arch digest (Recommended, Secure)</h3>
                <CopyBlock language="shell" code={`podman pull ${image.fullName}@${release.manifestDigest}`} />
              </div>
            ) : (
              <div class="p-3.5 rounded-xl border border-amber-500/30 bg-amber-500/10 text-amber-300 text-xs space-y-1">
                <div class="flex items-center gap-1.5 font-bold uppercase tracking-wider text-[10px] text-amber-400">
                  <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                  </svg>
                  <span>Security Advisory: Missing Cryptographic Digest</span>
                </div>
                <p class="leading-relaxed">This release is missing a canonical multi-architecture manifest digest. Falling back to tag-pinned reference; please note tags are mutable and do not guarantee build immutability.</p>
              </div>
            )}
            <div>
              <h3 class="mb-1 text-[10px] uppercase tracking-wider text-ink-400 font-bold font-mono">Pinned to release</h3>
              <CopyBlock language="shell" code={`podman pull ${versioned}`} />
            </div>
            <div>
              <h3 class="mb-1 text-[10px] uppercase tracking-wider text-ink-400 font-bold font-mono">Quick pull (rolling)</h3>
              <CopyBlock language="shell" code={`podman pull ${rolling}`} />
            </div>
            <div>
              <h3 class="mb-1 text-[10px] uppercase tracking-wider text-ink-400 font-bold font-mono">Hardened podman run</h3>
              <CopyBlock language="shell" code={podmanRun} />
            </div>
          </div>

          <div data-panel-id="compose" data-panel-active="false">
            <CopyBlock language="yaml" code={compose} label="docker-compose.yml" />
          </div>

          <div data-panel-id="k8s" data-panel-active="false">
            <CopyBlock language="yaml" code={kube} label="pod.yaml" />
          </div>

          <div data-panel-id="nix" data-panel-active="false">
            <CopyBlock language="nix" code={nixFlake} label="flake.nix" />
          </div>
        </Tabs>
      </div>
    </div>
  </div>
</section>
)}
