---
import Base from '../layouts/Base.astro';
import { loadIndex } from '../lib/catalog';
import { loadSiteConfig, tierLabel } from '../lib/site-config';

let index;
let error: string | null = null;
try { index = loadIndex(); } catch (e: any) { error = e.message; }

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const siteConfig = loadSiteConfig();
const home = siteConfig.site.home;
const devLabel = tierLabel(siteConfig, 'dev');
const distrolessLabel = tierLabel(siteConfig, 'distroless');

const runtimeImages = index ? index.images.filter((i) => (i.kind ?? 'runtime') === 'runtime' && i.tier !== 'service') : [];
const serviceImages = index ? index.images.filter((i) => i.kind === 'service') : [];
const latestImages = index ? runtimeImages.filter((i) => i.latestTag === index.latestTag) : [];
const totalSlots = index ? index.languages.length * index.tiers.length : 0;
const pending = index ? Math.max(0, totalSlots - runtimeImages.length) : 0;
const lagging = index ? runtimeImages.filter((i) => i.latestTag !== index.latestTag).length : 0;
const evidenceCoverage = index
  ? {
      signatures: latestImages.filter((i) => i.evidence?.signature ?? i.signed).length,
      provenance: latestImages.filter((i) => i.evidence?.provenance ?? i.provenance).length,
      scans: latestImages.filter((i) => !!i.evidence?.vulnerabilities).length,
    }
  : null;
const latestRelease = index?.releases.find((release) => release.isLatest) ?? index?.releases[0];
const generatedAt = index ? new Date(index.generatedAt).toLocaleString() : '';
const isReferenceSite = !index || (index.owner === 'northcutted' && index.repo === 'clearcutt');

const hrefFor = (href = '') => {
  const value = href.trim();
  if (!value || value === '/') return base;
  if (/^(https?:|mailto:|tel:)/.test(value) || value.startsWith('#')) return value;
  return `${base}${value.replace(/^\/+/, '')}`;
};
const isExternal = (href = '') => /^(https?:|mailto:|tel:)/.test(href.trim());
const personaStyles = [
  { eyebrow: 'Fleet operations', accent: 'border-accent/50 bg-accent/10 text-accent-soft' },
  { eyebrow: 'App delivery', accent: 'border-link/40 bg-link/10 text-link' },
  { eyebrow: 'Evidence review', accent: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-400' },
  { eyebrow: 'Workflow', accent: 'border-ink-600 bg-ink-800 text-ink-200' },
];
const personaMeta = (position: number) => personaStyles[position % personaStyles.length] ?? personaStyles[3];

const catalogStats = index
  ? [
      {
        label: 'Current runtimes',
        value: `${latestImages.length}/${totalSlots}`,
        helper: pending > 0 ? `${pending} pending matrix slots` : 'matrix slots accounted for',
      },
      {
        label: 'Release',
        value: index.latestTag,
        helper: latestRelease?.publishedAt
          ? `published ${new Date(latestRelease.publishedAt).toLocaleDateString()}`
          : 'latest catalog tag',
      },
      {
        label: 'Signatures',
        value: `${evidenceCoverage!.signatures}/${latestImages.length}`,
        helper: `${evidenceCoverage!.provenance}/${latestImages.length} provenance · ${evidenceCoverage!.scans}/${latestImages.length} scans`,
      },
      {
        label: 'Services',
        value: String(serviceImages.length),
        helper: lagging > 0 ? `${lagging} runtime entries lagging` : 'service image records',
      },
    ]
  : [];
---
<Base title="Home">
  <section class="space-y-10 pb-12" data-pagefind-body>
    <header class="grid min-w-0 gap-6 border-b border-ink-800/50 pb-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
      <div class="min-w-0 max-w-3xl space-y-4">
        <h1 class="heading text-3xl font-bold sm:text-4xl">{home.title}</h1>
        <p class="text-base leading-relaxed text-ink-200">{home.description}</p>
        {index && (
          <p class="text-sm leading-relaxed text-ink-300">
            {isReferenceSite ? 'This reference site renders the upstream catalog for ' : 'This generated portal renders catalog data for '}
            <span class="font-mono text-ink-100">{index.owner}/{index.repo}</span> from <span class="font-mono text-ink-100">{index.registryBase}</span>. ClearCutt provides the renderer and workflow kit; fork owners control their catalog and evidence.
          </p>
        )}
        <div class="flex flex-wrap gap-3 pt-1">
          <a href={`${base}catalog`} class="chip-accent">Open catalog</a>
          <a href={`${base}getting-started`} class="chip">Containerize your app</a>
          <a href={`${base}about?tab=audit`} class="chip">Audit guide</a>
        </div>
      </div>

      <div class="surface-soft min-w-0 space-y-3 rounded-lg border border-ink-800/60 px-4 py-3 text-xs text-ink-200">
        {index ? (
          <>
            <div class="flex items-center justify-between gap-3">
              <span class="font-semibold text-ink-50">Catalog snapshot</span>
              <span class="font-mono text-ink-300">{index.latestTag}</span>
            </div>
            <dl class="space-y-2">
              <div class="flex min-w-0 justify-between gap-3">
                <dt class="text-ink-300">Generated</dt>
                <dd class="min-w-0 break-words text-right font-mono text-ink-100">{generatedAt}</dd>
              </div>
              <div class="flex min-w-0 justify-between gap-3">
                <dt class="text-ink-300">Registry</dt>
                <dd class="min-w-0 break-all text-right font-mono text-ink-100">{index.registryBase}</dd>
              </div>
              <div class="flex min-w-0 justify-between gap-3">
                <dt class="text-ink-300">Source</dt>
                <dd class="min-w-0 break-all text-right font-mono text-ink-100">{index.owner}/{index.repo}</dd>
              </div>
              <div class="flex min-w-0 justify-between gap-3">
                <dt class="text-ink-300">Generator</dt>
                <dd class="min-w-0 break-words text-right font-mono text-ink-100">ClearCutt static portal</dd>
              </div>
            </dl>
          </>
        ) : (
          <>
            <p class="font-semibold text-warn">Catalog data missing</p>
            <p class="text-ink-300">{error ?? 'Run catalog generation before publishing this site.'}</p>
          </>
        )}
      </div>
    </header>

    {home.showNotice && (home.noticeTitle || home.noticeBody) && (
      <aside class="rounded-lg border border-warn/30 bg-warn/10 px-4 py-3 text-sm text-ink-200">
        {home.noticeTitle && <p class="font-semibold text-ink-50">{home.noticeTitle}</p>}
        {home.noticeBody && <p class="mt-1 text-xs leading-relaxed text-ink-300">{home.noticeBody}</p>}
      </aside>
    )}

    {home.quickLinks.length > 0 && (
      <section class="space-y-4">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="heading text-xl text-ink-50">Start Here</h2>
            <p class="mt-1 text-sm text-ink-300">Pick the next action instead of reading the site in order.</p>
          </div>
          <span class="chip">{home.quickLinks.length} paths</span>
        </div>
        <div class="grid gap-3 lg:grid-cols-4">
          {home.quickLinks.map((link, i) => (
            <a
              href={hrefFor(link.href)}
              target={isExternal(link.href) ? '_blank' : undefined}
              rel={isExternal(link.href) ? 'noreferrer' : undefined}
              class="group flex min-w-0 gap-3 rounded-lg border border-ink-800/60 bg-ink-900/30 p-4 no-underline transition hover:border-accent/40 hover:bg-ink-900/55"
            >
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-ink-700/70 bg-ink-950/55 font-mono text-[11px] font-semibold text-accent-soft">
                {i + 1}
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-semibold text-ink-50 group-hover:text-accent-soft">{link.label}</span>
                {link.description && <span class="mt-1 block text-xs leading-relaxed text-ink-300">{link.description}</span>}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    {home.personas.length > 0 && (
      <section class="space-y-5">
        <div>
          <h2 class="heading text-xl text-ink-50">Workflows By Role</h2>
          <p class="mt-1 text-sm text-ink-300">
            Each path points to existing catalog pages and commands, so the generated site stays useful after branding changes.
          </p>
        </div>
        <div class="grid min-w-0 gap-4 lg:grid-cols-3">
          {home.personas.map((persona, personaIndex) => {
            const meta = personaMeta(personaIndex);
            return (
            <section id={`persona-${persona.id}`} class="min-w-0 overflow-hidden rounded-xl border border-ink-800/60 bg-ink-900/35">
              <header class="space-y-3 border-b border-ink-800/60 bg-ink-950/25 p-5">
                <span class={`inline-flex w-fit rounded-full border px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider ${meta.accent}`}>
                  {meta.eyebrow}
                </span>
                <h3 class="text-base font-semibold text-ink-50">{persona.label}</h3>
                <p class="text-sm leading-relaxed text-ink-300">{persona.summary}</p>
              </header>
              <ol class="divide-y divide-ink-800/55 px-5">
                {persona.steps.map((step, i) => (
                  <li class="py-4">
                    <div class="flex min-w-0 gap-3">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-accent/30 bg-accent/10 font-mono text-[11px] font-semibold text-accent-soft">
                        {i + 1}
                      </span>
                      <div class="min-w-0 space-y-2">
                        <h4 class="text-sm font-semibold text-ink-50">{step.title}</h4>
                        <p class="text-xs leading-relaxed text-ink-300">{step.description}</p>
                        {step.href && (
                          <a
                            href={hrefFor(step.href)}
                            target={isExternal(step.href) ? '_blank' : undefined}
                            rel={isExternal(step.href) ? 'noreferrer' : undefined}
                            class="inline-flex text-xs font-semibold text-accent-soft hover:text-accent"
                          >
                            {step.ctaLabel ?? 'Open'}
                          </a>
                        )}
                        {step.command && (
                          <pre class="max-w-full overflow-x-auto whitespace-pre-wrap break-words rounded-md border border-ink-800 bg-ink-950/70 p-3 text-[11px] leading-relaxed text-ink-100 [overflow-wrap:anywhere]"><code class="whitespace-pre-wrap break-words [overflow-wrap:anywhere]">{step.command}</code></pre>
                        )}
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
            );
          })}
        </div>
      </section>
    )}

    {index ? (
      <section class="space-y-4">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <h2 class="heading text-xl text-ink-50">Current State</h2>
            <p class="mt-1 text-sm text-ink-300">
              Factual catalog counts only; inspect image detail pages before containerizing an app for production.
            </p>
          </div>
          <a href={`${base}catalog`} class="text-sm font-semibold text-accent-soft hover:text-accent">View matrix</a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {catalogStats.map((stat) => (
            <div class="surface-soft rounded-lg border border-ink-800/60 p-4">
              <dt class="text-[10px] font-bold uppercase tracking-wider text-ink-300">{stat.label}</dt>
              <dd class="mt-2 font-mono text-2xl font-semibold text-ink-50">{stat.value}</dd>
              <p class="mt-1 text-xs text-ink-300">{stat.helper}</p>
            </div>
          ))}
        </div>
      </section>
    ) : (
      <section class="surface-soft rounded-lg border border-ink-800/60 p-5">
        <h2 class="heading text-lg text-ink-50">Generate Catalog Data</h2>
        <p class="mt-2 text-sm text-ink-300">
          This template renders once generated catalog artifacts are copied under <code>public/catalog</code>.
        </p>
        <pre class="mt-4 overflow-x-auto whitespace-pre-wrap break-words rounded-md border border-ink-800 bg-ink-950/70 p-4 text-xs text-ink-100 [overflow-wrap:anywhere]"><code class="whitespace-pre-wrap break-words [overflow-wrap:anywhere]">clearcutt-verify catalog generate --config clearcutt.fleet.yaml --output ./dist/catalog
clearcutt-verify catalog site build --catalog ./dist/catalog --output ./dist/site --install</code></pre>
      </section>
    )}

    <section class="grid gap-4 border-t border-ink-800/50 pt-8 lg:grid-cols-3">
      <div class="space-y-2">
        <h2 class="heading text-lg text-ink-50">Tier Reminder</h2>
        <p class="text-sm leading-relaxed text-ink-300">
          {devLabel} images are for build stages. Production workloads should use {distrolessLabel} or a diagnostic runtime tier after reviewing the image detail page.
        </p>
      </div>
      <div class="space-y-2">
        <h2 class="heading text-lg text-ink-50">Evidence Reminder</h2>
        <p class="text-sm leading-relaxed text-ink-300">
          Signatures, provenance, SBOMs, vulnerability scans, test results, and release metadata are reported independently.
        </p>
      </div>
      <div class="space-y-2">
        <h2 class="heading text-lg text-ink-50">Customization</h2>
        <p class="text-sm leading-relaxed text-ink-300">
          Generated-site owners can change this homepage through <code>site.home</code> in <code>clearcutt.site.yaml</code>, or replace pages with <code>site-overrides</code>.
        </p>
      </div>
    </section>
  </section>
</Base>
