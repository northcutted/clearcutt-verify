---
import Base from '../../layouts/Base.astro';
import CopyBlock from '../../components/CopyBlock.astro';
import { loadLayerGraph, shortRef, humanBytes } from '../../lib/estate';

const graph = loadLayerGraph();
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const shortDigest = (d: string) => (d.length > 26 ? d.slice(0, 26) : d);

const command = `clearcutt-verify graph layers \\
  --observations dist/scan/observations.json \\
  --output dist/scan/layers.json \\
  --report dist/scan/commonality.md`;
---
<Base title="Layer commonality" description="What the estate has in common: the fleet core, blast radius, content-identical images, and what layer reuse saves.">
  <div class="space-y-10">
    <header class="space-y-3 border-b border-ink-800/40 pb-5">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-soft">Governance inventory</p>
      <h1 class="heading text-3xl font-bold">Layer commonality</h1>
      <p class="max-w-3xl text-xs sm:text-sm text-ink-300">
        What the estate has in common, measured by layer content. This is not a base-image relationship: images can share nearly all their content with no parentage between them. Shared content means shared exposure.
      </p>
      {graph && <p class="text-[11px] font-mono text-ink-400">Scanned {graph.generatedAt}</p>}
    </header>

    {!graph && (
      <section class="space-y-4 rounded-lg border border-ink-700/50 bg-ink-900/30 p-6">
        <h2 class="heading text-lg text-ink-50">No commonality scan yet</h2>
        <p class="max-w-3xl text-sm text-ink-300">
          Run <code>graph layers</code> over the same observations the <a class="text-accent-soft hover:underline" href={`${base}estate`}>estate page</a> uses, then rebuild the site with <code>--layers dist/scan/layers.json</code>.
        </p>
        <CopyBlock language="shell" code={command} />
      </section>
    )}

    {graph && (
      <>
        <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { label: 'Distinct layers', value: String(graph.summary.distinctLayers) },
            { label: 'In more than one image', value: String(graph.summary.sharedLayers) },
            { label: 'In every image', value: String(graph.summary.coreLayers) },
            { label: 'Avoided by sharing', value: `${Math.round(graph.summary.sharingRatio * 100)}%` },
          ].map((tile) => (
            <div class="rounded-lg border border-ink-800/40 surface-soft p-4">
              <p class="text-2xl font-bold font-mono text-ink-50">{tile.value}</p>
              <p class="mt-1 text-[11px] uppercase tracking-wider text-ink-400">{tile.label}</p>
            </div>
          ))}
        </section>

        <p class="text-sm text-ink-300">
          Stored once: <span class="font-mono text-ink-100">{humanBytes(graph.summary.storedBytes)}</span>. Without any layer reuse: <span class="font-mono text-ink-100">{humanBytes(graph.summary.naiveBytes)}</span>.
        </p>

        <section class="space-y-4">
          <h2 class="heading text-xl text-ink-50">Content-identical images</h2>
          {graph.identical.length === 0 ? (
            <p class="text-sm text-ink-300">No two observed images carry exactly the same layer set.</p>
          ) : (
            <>
              <p class="max-w-3xl text-sm text-ink-300">
                Published under different references but carrying byte-identical content. Usually this means a release republished something that did not change. Note that identical layers mean identical <em>content</em>, not identical <em>configuration</em> — entrypoint, user and labels can still differ.
              </p>
              <div class="space-y-3">
                {graph.identical.map((group) => (
                  <div class="rounded border border-ink-800/40 surface-soft p-4">
                    <p class="text-[11px] uppercase tracking-wider text-ink-400">
                      {group.images.length} images · {group.layerCount} layers · {humanBytes(group.bytes)}
                    </p>
                    <ul class="mt-2 space-y-1 font-mono text-xs text-ink-200">
                      {group.images.map((ref) => <li>{ref}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            </>
          )}
        </section>

        <section class="space-y-4">
          <h2 class="heading text-xl text-ink-50">Blast radius</h2>
          {graph.common.length === 0 ? (
            <p class="text-sm text-ink-300">No layer reaches the {Math.round(graph.summary.coverageThreshold * 100)}% coverage threshold.</p>
          ) : (
            <>
              <p class="max-w-3xl text-sm text-ink-300">
                The most widely carried layers. If one of these ships a vulnerable package, this is how far it reaches — regardless of whether any of these images is "based on" any other.
              </p>
              <div class="overflow-x-auto">
                <table class="w-full min-w-[42rem] text-left text-xs">
                  <thead class="text-ink-400 uppercase tracking-wider">
                    <tr><th class="py-2 pr-4">Layer</th><th class="py-2 pr-4 text-right">Size</th><th class="py-2 pr-4 text-right">Images</th><th class="py-2 text-right">Coverage</th></tr>
                  </thead>
                  <tbody class="font-mono text-ink-200">
                    {graph.common.slice(0, 25).map((layer) => (
                      <tr class="border-t border-ink-800/40">
                        <td class="py-2 pr-4 text-ink-100">{shortDigest(layer.digest)}</td>
                        <td class="py-2 pr-4 text-right">{humanBytes(layer.size ?? 0)}</td>
                        <td class="py-2 pr-4 text-right">{layer.imageCount}</td>
                        <td class="py-2 text-right">{Math.round(layer.coverage * 100)}%</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              {graph.common.length > 25 && (
                <p class="text-[11px] text-ink-400">{graph.common.length - 25} further common layers are in the graph JSON.</p>
              )}
            </>
          )}
        </section>

        {graph.clusters.length > 0 && (
          <section class="space-y-4">
            <h2 class="heading text-xl text-ink-50">Clusters</h2>
            <p class="max-w-3xl text-sm text-ink-300">
              Images connected by shared content — which images move together when that content changes.
            </p>
            <div class="grid gap-3 md:grid-cols-2">
              {graph.clusters.map((cluster) => (
                <div class="rounded border border-ink-800/40 surface-soft p-4">
                  <p class="text-[11px] uppercase tracking-wider text-ink-400">
                    Cluster {cluster.id} · {cluster.images.length} images · {cluster.sharedLayers} layers common to all · {humanBytes(cluster.sharedBytes)}
                  </p>
                  <ul class="mt-2 space-y-1 font-mono text-[11px] text-ink-200">
                    {cluster.images.map((ref) => <li>{shortRef(ref)}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )}

        <section class="space-y-4">
          <h2 class="heading text-xl text-ink-50">Per-image content profile</h2>
          <p class="max-w-3xl text-sm text-ink-300">
            How much of each image is content nothing else in the estate carries. A high unique share means remediating that image benefits only that image.
          </p>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[46rem] text-left text-xs">
              <thead class="text-ink-400 uppercase tracking-wider">
                <tr><th class="py-2 pr-4">Image</th><th class="py-2 pr-4 text-right">Layers</th><th class="py-2 pr-4 text-right">Shared</th><th class="py-2 pr-4 text-right">Unique</th><th class="py-2 pr-4 text-right">Total</th><th class="py-2 text-right">Unique share</th></tr>
              </thead>
              <tbody class="font-mono text-ink-200">
                {graph.images.map((img) => (
                  <tr class="border-t border-ink-800/40">
                    <td class="py-2 pr-4 text-ink-100">{shortRef(img.ref)}</td>
                    <td class="py-2 pr-4 text-right">{img.layers}</td>
                    <td class="py-2 pr-4 text-right">{img.sharedLayers}</td>
                    <td class="py-2 pr-4 text-right">{img.uniqueLayers}</td>
                    <td class="py-2 pr-4 text-right">{humanBytes(img.totalBytes)}</td>
                    <td class="py-2 text-right">{Math.round(img.uniqueShare * 100)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="space-y-2 rounded-lg border border-ink-700/50 bg-ink-900/30 p-5">
          <h2 class="text-xs font-bold uppercase tracking-[0.22em] text-accent-soft">What this does not prove</h2>
          <ul class="ml-4 list-disc space-y-1 text-xs text-ink-300">
            <li>Shared layers are shared content, never a base-image relationship. See <a class="text-accent-soft hover:underline" href={`${base}estate`}>the estate graph</a> for parentage.</li>
            <li>Sizes are compressed layer sizes from the manifest, not installed footprint on disk.</li>
            <li>Commonality is measured only across the images observed in this scan. Widening the scan changes every coverage percentage here.</li>
          </ul>
        </section>
      </>
    )}
  </div>
</Base>
