// ClearCutt Verify contributor environment: the Go CLI.
// After the container is created, `make check` is the canonical pre-PR gate
// (mirrors the pr-gate go-ci job).
{
  "name": "clearcutt-verify",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26"
    }
  },
  "postCreateCommand": "go -C cli mod download",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  }
}
