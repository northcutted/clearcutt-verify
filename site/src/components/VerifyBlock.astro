---
import Tabs from './Tabs.astro';
import CopyBlock from './CopyBlock.astro';
import type { ImageRecord, ReleaseEntry } from '../lib/catalog-schema';

interface Props {
  image: ImageRecord;
  release: ReleaseEntry;
  ownerRepo: string;
  showKyverno?: boolean;
}
const { image, release, ownerRepo, showKyverno = true } = Astro.props;
const catalogPath = './path/to/catalog';
const releaseTag = image.tier.id && image.tier.id !== 'service' ? `${release.tag}-${image.tier.id}` : release.tag;
const versioned = `${image.fullName}:${releaseTag}`;
const digestRef = release.manifestDigest ? `${image.fullName}@${release.manifestDigest}` : versioned;
const subject = release.signature?.certificate?.subject ?? '';
const issuer = release.signature?.certificate?.issuer ?? '';
const hasSignature = Boolean(subject && issuer && release.signature);
const hasProvenance = Boolean(release.provenance);
const hasSbom = Boolean(release.evidence?.sbom || Object.keys(release.assetUrls.sbom || {}).length > 0);
const hasTests = Boolean(release.evidence?.tests);
const hasRegistryEvidence = Boolean(release.manifestDigest && hasSignature && hasProvenance && hasSbom && hasTests);
const missingChannels = [
  !release.manifestDigest && 'manifest digest',
  !hasSignature && 'signature',
  !hasProvenance && 'provenance',
  !hasSbom && 'SBOM',
  !hasTests && 'test results',
].filter(Boolean).join(', ');

const runtimeId = image.language.id === 'c' ? 'cc15' : `${image.language.id}${image.language.version}`;

const clearcuttInspect = `CATALOG_DIR=${catalogPath}
clearcutt-verify --catalog "$CATALOG_DIR" inspect ${image.id} --tag ${release.tag}`;

const clearcuttVerify = `CATALOG_DIR=${catalogPath}
clearcutt-verify --catalog "$CATALOG_DIR" verify image ${image.id} \\
  --tag ${release.tag} \\
  --require-production \\
  --require-signature \\
  --require-sbom \\
  --require-provenance \\
  --max-critical 0 \\
  --max-high 5`;

const evidenceManifestInspect = `CATALOG_DIR=${catalogPath}
jq --arg image "${image.id}" --arg tag "${release.tag}" \\
  '.releases[] | select(.imageId == $image and .tag == $tag) | {imageRef, immutableRef, channels, missing}' \\
  "$CATALOG_DIR/evidence-manifest.json"`;

const clearcuttConformance = `clearcutt-verify conformance run \\
  --expect-runtime ${image.language.id}`;

const clearcuttOverlay = `clearcutt-verify overlay generate \\
  --runtime ${runtimeId} \\
  --tier ${image.tier.id} \\
  --base registry.access.redhat.com/ubi9/ubi-minimal \\
  --output my-${runtimeId}-overlay/`;

const cosignVerify = `cosign verify ${digestRef} \\
  --certificate-identity '${subject}' \\
  --certificate-oidc-issuer '${issuer}' \\
  --output json`;

const cosignAttest = `cosign verify-attestation ${digestRef} \\
  --type spdxjson \\
  --certificate-identity '${subject}' \\
  --certificate-oidc-issuer '${issuer}' \\
  | jq '.payload | @base64d | fromjson | .predicate'`;

const slsa = `slsa-verifier verify-image ${digestRef} \\
  --source-uri 'github.com/${ownerRepo}' \\
  --source-branch 'main'`;

const ghAttest = `gh attestation verify oci://${digestRef} \\
  --repo ${ownerRepo} \\
  --cert-identity '${subject}' \\
  --source-ref refs/heads/main`;

const policyGenerate = `CATALOG_DIR=${catalogPath}
clearcutt-verify --catalog "$CATALOG_DIR" policy ${image.id} \\
  --tag ${release.tag} \\
  --engine kyverno \\
  --environment production \\
  --namespace apps`;

const kyverno = `apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: verify-${image.imageName}
spec:
  validationFailureAction: Enforce
  background: false
  webhookTimeoutSeconds: 30
  rules:
    - name: verify-cosign-signature
      match:
        any:
          - resources:
              kinds: [Pod]
      verifyImages:
        - imageReferences: ["${image.fullName}:*"]
          attestors:
            - entries:
                - keyless:
                     subject: "${subject}"
                     issuer: "${issuer}"
          attestations:
            - predicateType: https://slsa.dev/provenance/v1
              attestors:
                - entries:
                    - keyless:
                        subject: "${subject}"
                        issuer: "${issuer}"
          mutateDigest: true
          verifyDigest: true
          required: true`;
---
<section id="verify" class="space-y-4 scroll-mt-24">
  <div>
    <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">Active Verification Toolkit</h3>
    <p class="mt-1 text-xs text-ink-400">
      {hasRegistryEvidence
        ? (showKyverno
          ? 'Run registry-side verification commands and generate example Kyverno policies for selected signature and SLSA provenance checks.'
          : 'Run registry-side verification commands for the recorded release evidence.')
        : 'This catalog record is missing one or more registry evidence channels. Start with catalog policy checks and the evidence manifest.'}
    </p>
  </div>

  <!-- Direct Cryptographic Evidence segment -->
  <div class="surface-soft border border-ink-800/60 rounded-2xl p-5 space-y-4">
    <h4 class="text-sm font-bold text-ink-50 uppercase tracking-wider">Direct Cryptographic Evidence &amp; Verification</h4>
    <div class="grid gap-4 sm:grid-cols-2 text-xs font-sans">
      <div class="space-y-2">
        <div>
          <span class="text-ink-400 font-bold block uppercase text-[10px]">Expected Certificate Subject</span>
          <code class="text-[11px] text-accent-soft block truncate bg-ink-950/80 px-2 py-1 rounded border border-ink-800 font-mono mt-0.5">{subject}</code>
        </div>
        <div>
          <span class="text-ink-400 font-bold block uppercase text-[10px]">Expected Certificate OIDC Issuer</span>
          <code class="text-[11px] text-ink-100 block truncate bg-ink-950/80 px-2 py-1 rounded border border-ink-800 font-mono mt-0.5">{issuer}</code>
        </div>
        {release.signature?.rekorLogIndex && (
          <div>
            <span class="text-ink-400 font-bold block uppercase text-[10px]">Rekor Transparency Log</span>
            <a 
              href={`https://search.sigstore.dev/?logIndex=${release.signature.rekorLogIndex}`}
              target="_blank" 
              rel="noreferrer" 
              class="inline-flex items-center gap-1.5 text-accent hover:text-accent-soft mt-1 font-semibold underline"
            >
              <span>View Log Index #{release.signature.rekorLogIndex} on search.sigstore.dev →</span>
            </a>
          </div>
        )}
      </div>

      <div class="space-y-2">
        <div>
          <span class="text-ink-400 font-bold block uppercase text-[10px]">Manifest Index Digest</span>
          <code class="text-[11px] text-ink-100 block truncate bg-ink-950/80 px-2 py-1 rounded border border-ink-800 font-mono mt-0.5">{release.manifestDigest || 'N/A'}</code>
        </div>
        {release.assetUrls.sbom && Object.keys(release.assetUrls.sbom).length > 0 && (
          <div>
            <span class="text-ink-400 font-bold block uppercase text-[10px]">Raw SPDX SBOMs</span>
            <div class="flex flex-wrap gap-2 mt-1">
              {Object.entries(release.assetUrls.sbom).map(([arch, url]) => (
                <a 
                  href={url}
                  target="_blank" 
                  rel="noreferrer" 
                  class="chip border-accent-soft/30 hover:border-accent text-ink-200"
                >
                  Download {arch.toUpperCase()} SBOM →
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
    
    <div class="space-y-1.5 border-t border-ink-800/40 pt-4">
      <span class="text-ink-400 font-bold block uppercase text-[10px]">One-step Audit Command</span>
      {hasRegistryEvidence ? (
        <>
          <p class="text-xs text-ink-300">Run the native compiled Go CLI command locally to verify the registry digest, Sigstore signature, SBOM and test attestations, and SLSA provenance:</p>
          <CopyBlock language="shell" code={`clearcutt-verify verify release-evidence \\
  --ref ${digestRef} \\
  --repo ${ownerRepo} \\
  --workflow-identity '${subject}'`} />
        </>
      ) : (
        <>
          <p class="text-xs text-ink-300">
            Missing or incomplete registry evidence: <strong class="text-ink-100">{missingChannels || 'unknown'}</strong>. Do not use registry verification or admission snippets until those channels are present.
          </p>
          <CopyBlock language="shell" code={evidenceManifestInspect} />
        </>
      )}
    </div>
  </div>

  <Tabs name={`verify-${image.id}`} tabs={[
    { id: 'clearcutt', label: 'ClearCutt CLI' },
    ...(hasRegistryEvidence ? [
      { id: 'cosign', label: 'Cosign' },
      { id: 'slsa', label: 'SLSA Verifier' },
      { id: 'gh-cli', label: 'GitHub CLI' },
      ...(showKyverno ? [{ id: 'kyverno', label: 'Kyverno Policy' }] : []),
    ] : []),
  ]}>
    <div data-panel-id="clearcutt" data-panel-active="true" class="space-y-6">
      <div class="space-y-2">
        <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">1. Inspect Security Metadata</h3>
        <p class="text-xs text-ink-400">
          Query deep, high-fidelity security metadata, dynamic entrypoints, non-root user settings, architectures, and release asset URLs.
        </p>
        <CopyBlock language="shell" code={clearcuttInspect} />
      </div>

      <div class="space-y-2 border-t border-ink-800/40 pt-5">
        <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">2. Local Policy Gate Verification</h3>
        <p class="text-xs text-ink-400">
          Check catalog-record evidence flags, smoke tests, vulnerability limits, and lifecycle constraints locally or in CI pipelines. Use the release-evidence command or the Cosign/SLSA tabs for registry-side cryptographic verification.
        </p>
        <CopyBlock language="shell" code={clearcuttVerify} />
      </div>

      <div class="space-y-2 border-t border-ink-800/40 pt-5">
        <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">3. Runtime Conformance Audit</h3>
        <p class="text-xs text-ink-400">
          Verify runtime specifications offline, asserting timezone configurations, dynamic links, CA certificate paths, and rootless isolation boundaries.
        </p>
        <CopyBlock language="shell" code={clearcuttConformance} />
      </div>

      <div class="space-y-2 border-t border-ink-800/40 pt-5">
        <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">4. Scaffold Nix Overlay Graft</h3>
        <p class="text-xs text-ink-400">
          Under strict corporate base OS mandates, generate a workspace scaffolding to graft this runtime overlay onto existing host layers.
        </p>
        <CopyBlock language="shell" code={clearcuttOverlay} />
      </div>
    </div>

    {hasRegistryEvidence && <div data-panel-id="cosign" data-panel-active="false" class="space-y-6">
      <div class="space-y-2">
        <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">1. Verify Keyless OIDC Signature</h3>
        <p class="text-xs text-ink-400">
          Confirm this OCI image was built in your official release workflow and signed via keyless OIDC certificates.
        </p>
        <CopyBlock language="shell" code={cosignVerify} />
      </div>

      <div class="space-y-2 border-t border-ink-800/40 pt-5">
        <h3 class="text-xs uppercase tracking-wider text-ink-300 font-bold">2. Verify Cryptographic SBOM Attestation</h3>
        <p class="text-xs text-ink-400">
          Extract and cryptographically verify the compiled package software bill of materials statement.
        </p>
        <CopyBlock language="shell" code={cosignAttest} />
      </div>
    </div>}

    {hasRegistryEvidence && <div data-panel-id="slsa" data-panel-active="false" class="space-y-4">
      <div>
        <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300 font-bold">slsa-verifier (SLSA Build L3)</h3>
        <p class="mb-3 text-xs text-ink-400">
          Verify SLSA Build L3 provenance from the configured builder and source ref.
        </p>
        <CopyBlock language="shell" code={slsa} />
      </div>
    </div>}

    {hasRegistryEvidence && <div data-panel-id="gh-cli" data-panel-active="false" class="space-y-4">
      <div>
        <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300 font-bold">GitHub Native Attestation</h3>
        <p class="mb-3 text-xs text-ink-400">
          Audit the GitHub-native provenance attestation using the GitHub CLI client.
        </p>
        <CopyBlock language="shell" code={ghAttest} />
      </div>
    </div>}

    {hasRegistryEvidence && showKyverno && (
      <div data-panel-id="kyverno" data-panel-active="false" class="space-y-4">
        <div data-kyverno-panel-root data-subject={subject} data-issuer={issuer} data-image-name={image.imageName} data-image-fullname={image.fullName}>
          <h3 class="mb-2 text-xs uppercase tracking-wider text-ink-300">Admission Control (Kyverno Policy)</h3>
          <p class="mb-3 text-xs text-ink-200">
            Use <code class="font-mono text-ink-100">clearcutt-verify policy</code> as the canonical generator for keyless signature and SLSA provenance checks; validate the generated YAML against your Kyverno version.
          </p>
          <CopyBlock language="shell" code={policyGenerate} />

          <!-- Interactive Policy Settings Card -->
          <div class="surface-soft p-4 border border-ink-700/40 rounded-xl space-y-4 mb-4">
            <div class="flex items-center justify-between gap-4">
              <div>
                <label class="text-xs font-semibold text-ink-100 uppercase tracking-wide block">Admission Action</label>
                <span class="text-[11px] text-ink-300">Set cluster behavior on signature check failure</span>
              </div>
              <div class="flex items-center gap-1 bg-ink-950 rounded-lg p-0.5 border border-ink-700/40 text-xs shrink-0 select-none" role="group" aria-label="Admission action">
                <button type="button" data-action-btn="Enforce" data-active="true" aria-pressed="true" class="px-3 py-1 rounded transition text-ink-300 data-[active=true]:bg-accent/15 data-[active=true]:text-accent-soft data-[active=true]:font-semibold focus:outline-none">
                  Enforce
                </button>
                <button type="button" data-action-btn="Audit" data-active="false" aria-pressed="false" class="px-3 py-1 rounded transition text-ink-300 data-[active=true]:bg-accent/15 data-[active=true]:text-accent-soft data-[active=true]:font-semibold focus:outline-none">
                  Audit
                </button>
              </div>
            </div>

            <div class="flex items-center justify-between gap-4 pt-3 border-t border-ink-800/40">
              <div>
                <label class="text-xs font-semibold text-ink-100 uppercase tracking-wide block">Require SLSA Provenance</label>
                <span class="text-[11px] text-ink-300">Block pods if they lack signed SLSA provenance from the release workflow</span>
              </div>
              <button type="button" data-provenance-toggle data-active="true" role="switch" aria-checked="true" aria-label="Require SLSA provenance" class="w-10 h-6 rounded-full p-1 bg-ink-950 border border-ink-700/40 transition-colors duration-200 relative focus:outline-none data-[active=true]:bg-accent/20 data-[active=true]:border-accent/40 shrink-0">
                <span class="w-3.5 h-3.5 rounded-full bg-ink-400 block transition-all duration-200 transform data-[active=true]:translate-x-4 data-[active=true]:bg-accent-soft" data-provenance-dot data-active="true" />
              </button>
            </div>
          </div>

          <div data-kyverno-code-block>
            <CopyBlock language="yaml" code={kyverno} label="policy.yaml" />
          </div>
        </div>
      </div>
    )}
  </Tabs>
</section>

<script is:inline>
  (function () {
    const root = document.querySelector('[data-kyverno-panel-root]');
    if (!root) return;

    const actionBtns = root.querySelectorAll('[data-action-btn]');
    const provenanceToggle = root.querySelector('[data-provenance-toggle]');
    const provenanceDot = root.querySelector('[data-provenance-dot]');
    const codeContainer = root.querySelector('[data-kyverno-code-block]');

    const subject = root.getAttribute('data-subject');
    const issuer = root.getAttribute('data-issuer');
    const imageName = root.getAttribute('data-image-name');
    const imageFullName = root.getAttribute('data-image-fullname');

    let currentAction = 'Enforce';
    let requireProvenance = true;

    function renderYaml() {
      const provenanceSection = requireProvenance
        ? `          attestations:
            - predicateType: https://slsa.dev/provenance/v1
              attestors:
                - entries:
                    - keyless:
                        subject: "${subject}"
                        issuer: "${issuer}"`
        : '';

      const lines = [
        'apiVersion: kyverno.io/v1',
        'kind: ClusterPolicy',
        'metadata:',
        `  name: verify-${imageName}`,
        'spec:',
        `  validationFailureAction: ${currentAction}`,
        '  background: false',
        '  webhookTimeoutSeconds: 30',
        '  rules:',
        '    - name: verify-cosign-signature',
        '      match:',
        '        any:',
        '          - resources:',
        '              kinds: [Pod]',
        '      verifyImages:',
        `        - imageReferences: ["${imageFullName}:*"]`,
        '          attestors:',
        '            - entries:',
        '                - keyless:',
        `                    subject: "${subject}"`,
        `                    issuer: "${issuer}"`,
        provenanceSection,
        '          mutateDigest: true',
        '          verifyDigest: true',
        '          required: true'
      ].filter(l => l !== '').join('\n');

      // Update inner code element inside CopyBlock
      const codeElement = codeContainer.querySelector('pre');
      if (codeElement) {
        codeElement.innerText = lines;
      }
    }

    actionBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-action-btn');
        currentAction = val;
        actionBtns.forEach(b => {
          const isActive = b.getAttribute('data-action-btn') === val;
          b.setAttribute('data-active', isActive ? 'true' : 'false');
          b.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
        renderYaml();
      });
    });

    provenanceToggle.addEventListener('click', () => {
      requireProvenance = !requireProvenance;
      provenanceToggle.setAttribute('data-active', requireProvenance ? 'true' : 'false');
      provenanceToggle.setAttribute('aria-checked', requireProvenance ? 'true' : 'false');
      provenanceDot.setAttribute('data-active', requireProvenance ? 'true' : 'false');
      renderYaml();
    });
  })();
</script>
