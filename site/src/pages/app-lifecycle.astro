---
import Base from '../layouts/Base.astro';
import CopyBlock from '../components/CopyBlock.astro';
import { loadImage, loadIndex } from '../lib/catalog';
import { loadSiteConfig, tierLabel } from '../lib/site-config';

let index;
try { index = loadIndex(); } catch { index = null; }
const ownerRepo = index ? `${index.owner}/${index.repo}` : 'northcutted/clearcutt-verify';
const imageNamespace = ownerRepo.toLowerCase();
const registryBase = index?.registryBase ?? `ghcr.io/${imageNamespace}`;
const imageRuntime = (id: string) => id.split('-')[0].toLowerCase();
const fallbackImagePrefix = (() => {
  const first = index?.images[0];
  if (!first) return 'clearcutt';
  try {
    const record = loadImage(first.id);
    const suffix = `-${imageRuntime(first.id)}`;
    return record.imageName.toLowerCase().endsWith(suffix)
      ? record.imageName.slice(0, -suffix.length)
      : 'clearcutt';
  } catch {
    return 'clearcutt';
  }
})();
const imageNameFor = (id: string) => {
  try {
    return loadImage(id).imageName;
  } catch {
    return `${fallbackImagePrefix}-${imageRuntime(id)}`;
  }
};
const baseRef = (id: string) => `${registryBase}/${imageNameFor(id)}:vX.Y.Z-distroless`;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const devLabel = tierLabel(loadSiteConfig(), 'dev');

const envCode = `export APP_IMAGE="ghcr.io/acme/payments-api:1.0.0"
export REBASED_IMAGE="ghcr.io/acme/payments-api:1.0.0-rebased"
export DEV_SIGNER="https://github.com/acme/payments/.github/workflows/release.yml@refs/heads/main"
export ENGINE_SIGNER="https://github.com/acme/platform/.github/workflows/rebase.yml@refs/heads/main"`;

const commonRebase = `cosign sign --yes "$APP_IMAGE"

clearcutt-verify app diff-base \\
  --image "$APP_IMAGE" \\
  --candidate-base "$PATCHED_BASE" \\
  --candidate-base-id "$BASE_ID" \\
  --fail-on-incompatible

clearcutt-verify app rebase \\
  --image "$APP_IMAGE" \\
  --candidate-base "$PATCHED_BASE" \\
  --candidate-base-id "$BASE_ID" \\
  --tag "$REBASED_IMAGE" \\
  --dev-identity "$DEV_SIGNER" \\
  --sign \\
  --attest

cosign verify "$REBASED_IMAGE" \\
  --certificate-identity "$ENGINE_SIGNER" \\
  --certificate-oidc-issuer https://token.actions.githubusercontent.com

cosign verify-attestation "$REBASED_IMAGE" \\
  --type https://clearcutt.dev/attestations/rebase/v1 \\
  --certificate-identity "$ENGINE_SIGNER" \\
  --certificate-oidc-issuer https://token.actions.githubusercontent.com`;

const stacks = [
  {
    title: 'Java',
    versions: '21, 25',
    bases: 'java21-* / java25-*',
    artifact: 'Fat JAR',
    note: 'Use a single executable JAR and JSON exec form.',
    code: `./mvnw -DskipTests package
cp target/payments-api-*-all.jar target/app.jar

export BASE_ID="java21-distroless"
export PATCHED_BASE="${baseRef('java21-distroless')}"

clearcutt-verify app build \\
  --base "$BASE_ID" \\
  --artifact target/app.jar \\
  --dest /workspace/app.jar \\
  --entrypoint '["java","-jar","/workspace/app.jar"]' \\
  --image "$APP_IMAGE"`
  },
  {
    title: 'Node.js',
    versions: '22, 24',
    bases: 'node22-* / node24-*',
    artifact: 'Bundled server module',
    note: 'Bundle runtime files into one server artifact.',
    code: `npm ci
npx esbuild src/server.ts \\
  --bundle \\
  --platform=node \\
  --target=node22 \\
  --format=esm \\
  --outfile=dist/server.mjs

export BASE_ID="node22-distroless"
export PATCHED_BASE="${baseRef('node22-distroless')}"

clearcutt-verify app build \\
  --base "$BASE_ID" \\
  --artifact dist/server.mjs \\
  --dest /workspace/server.mjs \\
  --entrypoint '["node","/workspace/server.mjs"]' \\
  --image "$APP_IMAGE"`
  },
  {
    title: 'Python',
    versions: '3.14',
    bases: 'python3.14-*',
    artifact: 'PEX, shiv, or zipapp',
    note: 'Package app and dependencies into one runnable file.',
    code: `python -m pip install --upgrade build pex
pex . \\
  -m payments_api.main \\
  -o dist/payments-api.pyz

export BASE_ID="python3.14-distroless"
export PATCHED_BASE="${baseRef('python3.14-distroless')}"

clearcutt-verify app build \\
  --base "$BASE_ID" \\
  --artifact dist/payments-api.pyz \\
  --dest /workspace/payments-api.pyz \\
  --entrypoint '["python","/workspace/payments-api.pyz"]' \\
  --image "$APP_IMAGE"`
  },
  {
    title: 'Go',
    versions: '1.25, 1.26',
    bases: 'go1.26-*',
    artifact: 'Linux executable',
    note: 'Mark the embedded binary executable.',
    code: `CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \\
  go build -trimpath -ldflags="-s -w" \\
  -o dist/payments-api ./cmd/payments-api

export BASE_ID="go1.26-distroless"
export PATCHED_BASE="${baseRef('go1.26-distroless')}"

clearcutt-verify app build \\
  --base "$BASE_ID" \\
  --artifact dist/payments-api \\
  --dest /workspace/payments-api \\
  --entrypoint '["/workspace/payments-api"]' \\
  --executable \\
  --image "$APP_IMAGE"`
  }
];
---
<Base title="Rebasable App Lifecycle" description="End-to-end ClearCutt app build, diff, rebase, signing, and attestation examples for each reference runtime line.">
  <div class="space-y-10">
    <header class="space-y-3 border-b border-ink-800/40 pb-5">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-soft">Downstream Images</p>
      <h1 class="heading text-3xl font-bold">Rebasable App Lifecycle</h1>
      <p class="max-w-3xl text-xs sm:text-sm text-ink-300">
        Build one signed application artifact onto a ClearCutt base, compare a patched base, and rebase later from CI without rebuilding the app layer. The examples below cover each runtime line the reference fleet publishes and keep the CLI flow aligned with the repository guide.
      </p>
    </header>

    <section class="grid min-w-0 gap-6 lg:grid-cols-[1fr_1.15fr]">
      <div class="surface-soft min-w-0 rounded-2xl border border-ink-800/40 p-6">
        <h2 class="heading text-xl text-ink-50">Artifact Contract</h2>
        <ul class="mt-4 space-y-3 text-sm text-ink-200">
          <li><code>app build</code> packages one prebuilt file into one OCI layer.</li>
          <li>Native binaries should pass <code>--executable</code>.</li>
          <li><code>--entrypoint</code> must be OCI JSON exec form.</li>
          <li><code>app diff-base</code> enforces same runtime family and major/minor line.</li>
          <li><code>app rebase --sign --attest</code> emits signed evidence only after developer signature verification succeeds.</li>
        </ul>
        <p class="mt-4 text-xs text-ink-400">
          If a service needs a publish directory or sidecar runtime files, use a normal Containerfile and run <code>clearcutt-verify certify</code> on the finished image.
        </p>
      </div>

      <div class="surface-soft min-w-0 rounded-2xl border border-ink-800/40 p-6">
        <h2 class="heading text-xl text-ink-50">Supported Stack Families</h2>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[36rem] text-left text-xs">
            <thead class="border-b border-ink-800/70 text-ink-300">
              <tr>
                <th class="py-2 pr-4 font-semibold">Stack</th>
                <th class="py-2 pr-4 font-semibold">Versions</th>
                <th class="py-2 pr-4 font-semibold">Base ids</th>
                <th class="py-2 font-semibold">Artifact</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink-800/50 text-ink-100">
              {stacks.map((stack) => (
                <tr>
                  <td class="py-2 pr-4 font-semibold">{stack.title}</td>
                  <td class="py-2 pr-4 text-ink-300">{stack.versions}</td>
                  <td class="py-2 pr-4 font-mono text-[11px] text-accent-soft">{stack.bases}</td>
                  <td class="py-2 text-ink-300">{stack.artifact}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="min-w-0 space-y-4">
      <h2 class="heading text-xl text-ink-50">Common Rebase Loop</h2>
      <p class="max-w-3xl text-sm text-ink-200">
        Each stack example sets <code>BASE_ID</code> and <code>PATCHED_BASE</code>. The source image, rebased tag, developer signer, and rebase-engine signer stay the same across stacks.
        These examples assume a generated or live catalog; a clean clone only proves the Java 21 fixture path. Preview lifecycle lines such as <code>java25-*</code> require policies or gates that explicitly allow preview bases.
      </p>
      <div class="grid min-w-0 gap-6 lg:grid-cols-2">
        <CopyBlock language="shell" label="shared environment" code={envCode} />
        <CopyBlock language="shell" label="sign, diff, rebase, verify" code={commonRebase} />
      </div>
    </section>

    <section class="min-w-0 space-y-6">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="heading text-xl text-ink-50">Stack Examples</h2>
          <p class="mt-1 max-w-3xl text-sm text-ink-200">
            Swap the versioned base id to the matching supported line when your service targets a newer runtime.
          </p>
        </div>
        <a href={`${base}cli`} class="text-xs font-semibold uppercase tracking-wider text-accent-soft hover:text-accent transition">
          CLI reference
        </a>
      </div>
      <div class="grid min-w-0 gap-6 xl:grid-cols-2">
        {stacks.map((stack) => (
          <article class="surface-soft min-w-0 rounded-2xl border border-ink-800/40 p-6">
            <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="heading text-lg text-ink-50">{stack.title}</h3>
                <p class="text-xs text-ink-400">{stack.note}</p>
              </div>
              <span class="inline-flex w-fit rounded bg-accent/15 px-2 py-0.5 text-[10px] font-mono font-bold uppercase tracking-wider text-accent-soft">{stack.bases}</span>
            </div>
            <CopyBlock language="shell" code={stack.code} />
          </article>
        ))}
      </div>
    </section>

    <section class="grid min-w-0 gap-6 lg:grid-cols-2">
      <div class="surface-soft min-w-0 rounded-2xl border border-ink-800/40 p-6">
        <h2 class="heading text-xl text-ink-50">CI Identity Model</h2>
        <p class="mt-3 text-sm text-ink-200">
          The developer release workflow signs the original app image. A separate rebase workflow verifies that source signature, performs the base swap, signs the rebased image, and attaches the rebase predicate. Admission policy should pin the rebase workflow identity and inspect the predicate fields.
        </p>
        <div class="mt-4 text-xs text-ink-400">
          Required predicate fields include <code>rebaseDecision: allowed</code>, <code>developerSignatureVerified: true</code>, and the expected developer identity and issuer.
        </div>
      </div>
      <div class="surface-soft min-w-0 rounded-2xl border border-ink-800/40 p-6">
        <h2 class="heading text-xl text-ink-50">Multi-Architecture Notes</h2>
        <p class="mt-3 text-sm text-ink-200">
          The examples build the platform-specific image for the artifact you pass in. For multi-arch releases, build one artifact per platform and assemble an image index with your release tooling; <code>app rebase</code> can rebase indexes whose child images carry the ClearCutt rebase labels.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={`${base}getting-started`} class="text-xs font-semibold uppercase tracking-wider text-accent-soft hover:text-accent transition">Getting Started</a>
          <a href={`${base}cli`} class="text-xs font-semibold uppercase tracking-wider text-accent-soft hover:text-accent transition">CLI Tools</a>
        </div>
      </div>
    </section>
  </div>
</Base>
