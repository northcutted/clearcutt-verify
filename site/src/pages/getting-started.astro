---
import Base from '../layouts/Base.astro';
import CopyBlock from '../components/CopyBlock.astro';
import { loadIndex } from '../lib/catalog';
import { loadSiteConfig, tierLabel } from '../lib/site-config';

let index;
try { index = loadIndex(); } catch { index = null; }
const ownerRepo = index ? `${index.owner}/${index.repo}` : 'northcutted/clearcutt-verify';
const repoDir = ownerRepo.split('/')[1] ?? 'clearcutt';
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const siteConfig = loadSiteConfig();
const tierLabels = {
  distroless: tierLabel(siteConfig, 'distroless'),
  slim: tierLabel(siteConfig, 'slim'),
  dev: tierLabel(siteConfig, 'dev'),
};
---
<Base title="App-Team Getting Started">
  <div class="space-y-10">
    <header class="space-y-2 border-b border-ink-800/40 pb-4">
      <h1 class="heading text-3xl font-bold">App-Team Getting Started</h1>
      <p class="text-xs sm:text-sm text-ink-300">
        Choose a catalog image, generate a starter, build with the matching {tierLabels.dev} image, and certify the app image before deployment. No Nix required.
      </p>
    </header>

    <section class="rounded-lg border border-accent/25 bg-accent/10 p-5">
      <h2 class="text-xs font-bold uppercase tracking-[0.22em] text-accent-soft">Role boundary</h2>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-200">
        Platform teams own the fork, Nix builds, release evidence, and catalog. Application teams use Docker, Podman, Kubernetes, Cosign, devcontainers, and the ClearCutt CLI.
      </p>
    </section>

    <section class="space-y-4 max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-accent/15 border border-accent/30 text-xs font-bold text-accent-soft font-mono">1</span>
        <h2 class="heading text-xl text-ink-50">Prove The CLI From A Clean Clone</h2>
      </div>
      <p class="text-sm text-ink-200">
        Start with the committed fixture catalog. After your platform team publishes a catalog, replace the fixture path with that generated catalog directory.
      </p>
      <CopyBlock language="shell" code={`git clone https://github.com/${ownerRepo}.git\ncd ${repoDir}\ngo -C cli build -o ../clearcutt-verify ./cmd/clearcutt-verify\n\n./clearcutt --catalog cli/internal/testdata/catalog list\n./clearcutt --catalog cli/internal/testdata/catalog inspect java21-distroless\n./clearcutt --catalog cli/internal/testdata/catalog verify image java21-distroless \\\n  --require-signature \\\n  --require-sbom \\\n  --require-provenance \\\n  --max-critical 0 \\\n  --max-high 3 \\\n  --allow-preview`} />
    </section>

    <section class="space-y-4 max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-accent/15 border border-accent/30 text-xs font-bold text-accent-soft font-mono">2</span>
        <h2 class="heading text-xl text-ink-50">Generate A Starter App</h2>
      </div>
      <p class="text-sm text-ink-200">
        The starter includes a Dockerfile, devcontainer, certification policy, release workflow, and rebase workflow.
      </p>
      <CopyBlock language="shell" code={`./clearcutt-verify app template java --output examples/my-java-service --name my-java-service`} />
    </section>

    <section class="space-y-4 max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-accent/15 border border-accent/30 text-xs font-bold text-accent-soft font-mono">3</span>
        <h2 class="heading text-xl text-ink-50">Use The Dev Path</h2>
      </div>
      <p class="text-sm text-ink-200">
        Use the matching {tierLabels.dev} image for build tools. The first command is fixture-backed and prints a devcontainer; the container command needs Docker or Podman access to the configured dev image.
      </p>
      <CopyBlock language="shell" code={`./clearcutt-verify --catalog cli/internal/testdata/dev-catalog dev java21-distroless --devcontainer --print\n./clearcutt --catalog cli/internal/testdata/dev-catalog dev java21-distroless --container --engine docker --command 'java -version'`} />
    </section>

    <section class="space-y-4 max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-accent/15 border border-accent/30 text-xs font-bold text-accent-soft font-mono">4</span>
        <h2 class="heading text-xl text-ink-50">Build And Certify</h2>
      </div>
      <p class="text-sm text-ink-200">
        Certify the app image archive before deployment or admission.
      </p>
      <CopyBlock language="shell" code={`docker build -t ghcr.io/acme/payments-api:1.0.0 examples/my-java-service\ndocker push ghcr.io/acme/payments-api:1.0.0\nAPP_DIGEST=$(docker buildx imagetools inspect ghcr.io/acme/payments-api:1.0.0 \\\n  --format '{{json .Manifest.Digest}}' | tr -d '"')\ndocker save ghcr.io/acme/payments-api:1.0.0 -o payments-api.tar\n\n./clearcutt certify payments-api.tar \\\n  --base java21-distroless \\\n  --policy examples/my-java-service/certification-policy.yaml \\\n  --image-ref "ghcr.io/acme/payments-api@\${APP_DIGEST}"`} />
    </section>

    <section class="grid gap-4 max-w-4xl md:grid-cols-3">
      <div class="surface-soft border border-ink-800/40 rounded-lg p-5 space-y-2">
        <h3 class="font-semibold text-xs uppercase tracking-wider text-ink-50">Use JSON exec form</h3>
        <p class="text-[11px] text-ink-200 leading-relaxed font-sans">
          {tierLabels.distroless} has no shell. Use <code class="font-mono text-ink-100">ENTRYPOINT ["java","-jar","/workspace/app.jar"]</code>, not shell form.
        </p>
      </div>
      <div class="surface-soft border border-ink-800/40 rounded-lg p-5 space-y-2">
        <h3 class="font-semibold text-xs uppercase tracking-wider text-ink-50">Keep tools in dev</h3>
        <p class="text-[11px] text-ink-200 leading-relaxed font-sans">
          Install and compile dependencies in the {tierLabels.dev} stage, then copy only runtime artifacts into the final image.
        </p>
      </div>
      <div class="surface-soft border border-ink-800/40 rounded-lg p-5 space-y-2">
        <h3 class="font-semibold text-xs uppercase tracking-wider text-ink-50">Separate proof paths</h3>
        <p class="text-[11px] text-ink-200 leading-relaxed font-sans">
          Use <code class="font-mono text-ink-100">verify image</code> for catalog policy checks and registry-side commands for cryptographic evidence.
        </p>
      </div>
    </section>

    <div class="flex flex-wrap gap-3 border-t border-ink-800/40 pt-6">
      <a href={`${base}app-lifecycle`} class="chip">Open app lifecycle</a>
      <a href={`${base}catalog`} class="chip">Browse catalog</a>
      <a href={`${base}about?tab=audit`} class="chip">Audit evidence</a>
    </div>
  </div>
</Base>
