---
import Base from '../layouts/Base.astro';
import CopyBlock from '../components/CopyBlock.astro';
import { loadIndex } from '../lib/catalog';
import { claims } from '../lib/claims';
import { loadSiteConfig, tierLabel } from '../lib/site-config';

let index;
try { index = loadIndex(); } catch { index = null; }
const siteConfig = loadSiteConfig();
const importedMode = siteConfig.site.catalogMode === 'imported';
const tierLabels = {
  distroless: tierLabel(siteConfig, 'distroless'),
  slim: tierLabel(siteConfig, 'slim'),
  dev: tierLabel(siteConfig, 'dev'),
};
const decisionsUrl = index ? `${index.repoUrl}/blob/main/docs/decisions.md` : 'https://github.com';

const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const hrefFor = (href = '') => {
  const value = href.trim();
  if (!value || value === '/') return base;
  if (/^(https?:|mailto:|tel:)/.test(value) || value.startsWith('#')) return value;
  return `${base}${value.replace(/^\/+/, '')}`;
};

const sample = index?.images.find(img => img.tier === 'distroless') ?? index?.images[0];
const ownerRepo = index ? `${index.owner}/${index.repo}` : 'OWNER/REPO';
const latestTag = index?.latestTag ?? 'vX.Y.Z';

// Build a real, valid pull-ref for the example. OCI repository names are
// lowercase only; the catalog already stores the lowercased form so we use
// that rather than reconstructing from (language, version, tier).
const sampleImageName = sample
  ? `clearcutt-${sample.language}${sample.languageVersion}`.toLowerCase()
  : 'clearcutt-corelts';
const sampleRegistryBase = index?.registryBase ?? `ghcr.io/${ownerRepo.toLowerCase()}`;
const sampleRefVersioned = `${sampleRegistryBase}/${sampleImageName}:${latestTag}-${sample?.tier ?? 'slim'}`;

// The cert SAN baked in by GitHub Actions OIDC is the exact workflow file URL
// at the ref that built the image. Releases are approved by creating a version
// tag, but signing still happens in the main release workflow run, so pin the
// workflow path and branch for BOTH signatures and attestations.
const workflowIdentityRegex =
  `^https://github\\.com/${ownerRepo}/\\.github/workflows/release\\.yml@refs/heads/main$`;
const releaseWorkflowIdentity =
  `https://github.com/${ownerRepo}/.github/workflows/release.yml@refs/heads/main`;
const oidcIssuer = 'https://token.actions.githubusercontent.com';
---
<Base title="About & Audit">
  <div class="space-y-8">
    <header class="space-y-2 border-b border-ink-800/40 pb-4">
      <h1 class="heading text-3xl font-bold">About &amp; Audit Guide</h1>
      <p class="text-xs sm:text-sm text-ink-300">Understand the ClearCutt threat model boundaries, runtime tiers, and run cryptographic verification checks.</p>
    </header>

    {importedMode ? (
      <section class="surface space-y-5 p-6 text-sm text-ink-200">
        <div>
          <span class="chip-accent">Catalog-only trust boundary</span>
          <h2 class="heading mt-3 text-2xl text-ink-50">Verify evidence before trusting it.</h2>
        </div>
        <p>
          This catalog governs OCI images that ClearCutt did not build. Observed metadata, supplied artifacts,
          and missing evidence are reported separately; no signature, SBOM, provenance, test, or scan is inferred.
        </p>
        <ul class="list-disc space-y-2 pl-6">
          <li><strong class="text-ink-50">Observed</strong> means metadata or an artifact was recorded, not cryptographically verified.</li>
          <li><strong class="text-ink-50">Verified</strong> is reserved for a ClearCutt verifier result.</li>
          <li><strong class="text-ink-50">Stale</strong> evidence remains visible but does not satisfy current policy gates.</li>
          <li>Use digest-pinned OCI references and run registry-side Cosign or provenance verification independently.</li>
        </ul>
        <p class="text-ink-300">
          Catalog-only mode has no Nix build claim, automatic scan schedule, or production approval unless the owning repository explicitly implements and proves those controls.
        </p>
      </section>
    ) : (<>
    <!-- Glassmorphic Tabs Selector -->
    <div class="flex justify-start">
      <div class="inline-flex rounded-full border border-ink-800 bg-ink-950/60 p-1 font-sans text-xs" role="tablist" aria-label="About page sections">
        <button
          type="button"
          role="tab"
          id="about-tab-architecture"
          data-tab-trigger="architecture"
          aria-selected="true"
          aria-controls="about-panel-architecture"
          tabindex="0"
          class="flex items-center gap-1.5 rounded-full px-5 py-2.5 font-medium uppercase tracking-wider transition-all select-none hover:text-ink-50 text-accent-soft bg-accent/15 border border-accent/20"
        >
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
          Architecture &amp; Tiers
        </button>
        <button
          type="button"
          role="tab"
          id="about-tab-audit"
          data-tab-trigger="audit"
          aria-selected="false"
          aria-controls="about-panel-audit"
          tabindex="-1"
          class="flex items-center gap-1.5 rounded-full px-5 py-2.5 font-medium uppercase tracking-wider text-ink-300 transition-all select-none hover:text-ink-50 border border-transparent"
        >
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.75h-.152c-3.196 0-6.1-1.249-8.25-3.286zm0 13.036h.008v.008H12v-.008z" /></svg>
          Supply Chain Audit Guide
        </button>
      </div>
    </div>

    <!-- Panel 1: Architecture & Tiers -->
    <div data-tab-panel="architecture" id="about-panel-architecture" role="tabpanel" aria-labelledby="about-tab-architecture" aria-hidden="false" class="space-y-8 max-w-3xl">
      <article class="prose-invert space-y-8 text-ink-200">
        <!-- Brand Slogan Callout Box -->
        <div class="relative rounded-2xl border border-accent/20 bg-gradient-to-br from-accent/5 to-accent-soft/10 p-6 shadow-xl overflow-hidden">
          <div class="absolute -right-16 -top-16 h-48 w-48 rounded-full bg-accent/5 blur-[40px] pointer-events-none" />
          <div class="relative z-10 space-y-2">
            <h2 class="text-xs font-bold uppercase tracking-[0.22em] text-accent-soft">THE CLEARCUTT BLUEPRINT</h2>
            <div class="heading text-xl sm:text-2xl font-black uppercase text-ink-50 tracking-wide">
              Hardened Base Images,<br />
              <span class="text-accent-soft bg-gradient-to-r from-accent-soft to-accent bg-clip-text text-transparent">Nix Closure Built.</span>
            </div>
            <p class="text-xs text-ink-300 max-w-xl font-sans pt-1 leading-relaxed">
              {claims.hero.description}
            </p>
          </div>
        </div>

        <header class="space-y-2">
          <h2 class="heading text-xl text-ink-50">About ClearCutt</h2>
          
          <!-- Project Status & Maturity Notice -->
          <div class="rounded-xl border border-blue-500/20 bg-blue-950/10 p-4 text-xs text-blue-200/90 leading-relaxed font-sans mb-4">
            <strong>Project Status &amp; Readiness:</strong> ClearCutt is a pre-1.0 open-source blueprint currently maintained by a single author. The public catalog serves as a worked-example of a live image hardening feed. Before using these runtimes in critical production environments, downstream organizations should bootstrap their own control-plane repository, operate their own builds or imported image inventory, and conduct independent verification.
          </div>

          <p>
            ClearCutt is a free, open-source CLI and reference implementation for platform and security engineers who want GitHub-native container image control planes, signed evidence-backed runtime tiers, and shell-free distroless options. Teams can start with a Nix-free catalog-only control plane around images they already publish, then graduate to the fleet profile when they want ClearCutt to build and govern custom internal container feeds.
          </p>
          <p>
            Our supply chain pipeline compiles target runtimes as isolated <code class="font-mono text-ink-100">/nix/store</code> closures with declared inputs. The catalog serves as a live worked example for inspecting OCI build evidence, from OIDC-based signing to OpenVEX exploitability records.
          </p>
        </header>

        <!-- Supply Chain Architecture Flow Section -->
        <section class="space-y-4 pt-2">
          <h2 class="heading text-xl text-ink-50">Supply Chain Architecture Flow</h2>
          <p class="text-sm">
            The end-to-end ClearCutt trust flow coordinates Nix store base builds, OIDC-based signing and attestation metadata, and Kubernetes dynamic policy checks at admission time:
          </p>
          <div class="rounded-2xl border border-ink-800 bg-ink-950/40 p-4 sm:p-6 shadow-lg">
            <img src={hrefFor('/supply-chain-flow.svg')} alt="ClearCutt Supply Chain Architecture" class="w-full h-auto" />
          </div>
        </section>

        <!-- Compliance & Audit Alignment Section -->
        <section class="space-y-4">
          <h2 class="heading text-xl text-ink-50">Structural Hardening &amp; Compliance Traits</h2>
          <p class="text-sm">
            Auditing modern cloud-native systems requires proof of configuration. ClearCutt translates traditional soft policies into verifiable, structural traits:
          </p>
          <div class="grid gap-4 sm:grid-cols-3">
            <div class="surface-soft border border-ink-800/40 rounded-xl p-4 space-y-2">
              <div class="flex items-center gap-2">
                <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400" />
                <h3 class="font-semibold text-xs uppercase tracking-wider text-ink-50">Structural Hardening</h3>
              </div>
              <p class="text-[11px] text-ink-200 leading-relaxed font-sans">
                {claims.stig.description}
              </p>
            </div>
            <div class="surface-soft border border-ink-800/40 rounded-xl p-4 space-y-2">
              <div class="flex items-center gap-2">
                <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400" />
                <h3 class="font-semibold text-xs uppercase tracking-wider text-ink-50">Cryptographic Overlays</h3>
              </div>
              <p class="text-[11px] text-ink-200 leading-relaxed font-sans">
                {claims.cryptography.description}
              </p>
            </div>
            <div class="surface-soft border border-ink-800/40 rounded-xl p-4 space-y-2">
              <div class="flex items-center gap-2">
                <span class="inline-flex h-2 w-2 rounded-full bg-emerald-400" />
                <h3 class="font-semibold text-xs uppercase tracking-wider text-ink-50">Rescan Without Rebuild</h3>
              </div>
              <p class="text-[11px] text-ink-200 leading-relaxed font-sans">
                When an SPDX SBOM is attached to an image, the catalog can re-scan it nightly against the current vulnerability database — newly-disclosed CVEs surface without rebuilding the image. A scheduled job can draft gated remediation PRs when explicitly enabled; nothing merges or deploys on its own.
              </p>
            </div>
          </div>
        </section>

        <section class="space-y-2">
          <h2 class="heading text-xl text-ink-50">Tiers, at a glance</h2>
          <div class="surface-soft divide-y divide-ink-700/40 rounded-2xl border border-ink-800/40 overflow-hidden">
            <div class="p-4">
              <h3 class="font-medium text-ink-50">{tierLabels.distroless}</h3>
              <p class="text-sm text-ink-200">No shells, no coreutils, no package manager. Only the language runtime and CA certificates. Smallest attack surface; not for debugging.</p>
            </div>
            <div class="p-4">
              <h3 class="font-medium text-ink-50">{tierLabels.slim}</h3>
              <p class="text-sm text-ink-200">Adds <code class="font-mono">busybox</code>/<code class="font-mono">bash</code> and minimal troubleshooting tooling. Production runtime when you still want a way in.</p>
            </div>
            <div class="p-4">
              <h3 class="font-medium text-ink-50">{tierLabels.dev}</h3>
              <p class="text-sm text-ink-200">Full compiler toolchain, debug shells, and the transient credential helper. Strictly build-time; never deploy this to clusters.</p>
            </div>
          </div>
        </section>

        <section class="space-y-2">
          <h2 class="heading text-xl text-ink-50">Runtime closure policy</h2>
          <p class="text-sm">
            ClearCutt defaults to a compatibility-first runtime closure, then makes the trade-offs
            explicit. The baseline keeps the primary language runtime, CA trust, required dynamic
            libraries, and the transitive packages Nix proves are reachable from that runtime.
            The {tierLabels.slim} tier adds only a small diagnostic shell/tool surface. {tierLabels.distroless} removes that
            operator surface.
          </p>
          <p class="text-sm">
            Packages that exist mainly for optional features, such as Java printing, AWT, fonts, or
            image codecs, are tracked as pruning candidates instead of being silently removed. The
            default image should run ordinary workloads without customization; specialized users can
            fork the Nix closure or adopt a future minimal profile when they can prove they do not
            need those compatibility edges.
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="heading text-xl text-ink-50">What we attest</h2>
          <ul class="list-disc space-y-1.5 pl-6 text-sm">
            <li><strong class="text-ink-50">SPDX SBOM</strong> — emitted by Syft from the actual OCI archive, attached to the manifest as a cosign predicate of type <code class="font-mono">spdxjson</code>.</li>
            <li><strong class="text-ink-50">Test results</strong> — a custom predicate recording the vulnerability and structure gates that passed before publication.</li>
            <li><strong class="text-ink-50">SLSA Build L3 provenance</strong> — generated by the upstream <a href="https://github.com/slsa-framework/slsa-github-generator">slsa-github-generator</a> reusable workflow, against the multi-arch manifest digest.</li>
            <li><strong class="text-ink-50">Sigstore keyless signature</strong> — cert chain points back to the exact GitHub Actions workflow file and ref that built the image.</li>
          </ul>
          <p class="text-sm text-ink-300">
            The catalog reports those channels independently; provenance never stands in for a
            missing signature, and vulnerability scans show as pending until every architecture has
            fresh scan data.
          </p>
        </section>

        <section class="space-y-2">
          <h2 class="heading text-xl text-ink-50">Threat model boundaries</h2>
          <p class="text-sm">
            {tierLabels.distroless} removes <code class="font-mono">exec()</code>-style shell escapes but does
            <em>not</em> mitigate every RCE class. Direct syscalls, bundled interpreter APIs, or
            statically-linked shells inside an application binary are unaffected. See the
            <a href={decisionsUrl} target="_blank" rel="noreferrer" class="text-accent-soft underline hover:text-accent">architectural decisions log</a>
            in the repo for the full trade-off discussion.
          </p>
        </section>
      </article>
    </div>

    <!-- Panel 2: Supply Chain Audit Guide -->
    <div data-tab-panel="audit" id="about-panel-audit" role="tabpanel" aria-labelledby="about-tab-audit" aria-hidden="true" class="hidden space-y-8 max-w-3xl">
      <article class="space-y-10 text-ink-200">
        <header class="space-y-3">
          <h2 class="heading text-xl text-ink-50">Verifying ClearCutt images</h2>
          <p class="text-sm text-ink-200">
            ClearCutt release workflows are configured to attach independent evidence with
            the GHCR manifest when it is available: a Sigstore signature (keyless OIDC), an
            SPDX SBOM attestation, SLSA provenance, and GitHub-native provenance attestations.
            The catalog marks each evidence channel separately so a missing signature,
            attestation, or scan is visible instead of being inferred from another signal.
          </p>
          <p class="text-xs text-ink-300">
            The examples below use <code class="font-mono text-ink-100">{sampleImageName}</code>
            pinned to <code class="font-mono text-ink-100">{latestTag}-{sample?.tier ?? 'distroless'}</code>. Swap in any image
            from the catalog — the verification flow is identical.
          </p>
        </header>

        <section class="space-y-3">
          <h3 class="heading text-base text-ink-50">1. Verify with the CLI</h3>
          <CopyBlock language="shell" code={`clearcutt-verify verify release-evidence \\\n  --ref ${sampleRefVersioned} \\\n  --repo ${ownerRepo} \\\n  --workflow-identity "${releaseWorkflowIdentity}" \\\n  --source-ref refs/heads/main \\\n  --source-branch main \\\n  --core-dir core`} />
          <p class="text-xs text-ink-300">
            From a scaffolded fleet repo, the CLI resolves the immutable digest and runs
            Cosign, SLSA verifier, and GitHub attestation checks through the pinned Nix
            backend. The manual commands below expose the same trust boundaries for
            inspection; run them from <code class="font-mono text-ink-100">nix develop ./core</code>
            or with equivalent local tools.
          </p>
        </section>

        <section class="space-y-3">
          <h3 class="heading text-base text-ink-50">2. Verify the signature</h3>
          <p class="text-sm text-ink-200">
            ClearCutt uses keyless OIDC — there's no static public key. Instead you assert which
            workflow file built the image (the cert SAN) and which OIDC issuer signed the cert.
            The regex below pins both pieces literally.
          </p>
          <CopyBlock language="shell" code={`cosign verify ${sampleRefVersioned} \\\n  --certificate-identity-regexp '${workflowIdentityRegex}' \\\n  --certificate-oidc-issuer '${oidcIssuer}'`} />
        </section>

        <section class="space-y-3">
          <h3 class="heading text-base text-ink-50">3. Verify the SBOM attestation</h3>
          <p class="text-sm text-ink-200">
            Confirms the SPDX SBOM on the manifest was produced by the same workflow run that
            signed the image. Same identity regex as step 2 — never loosen it (matching any
            workflow under the repo would let any reusable workflow signed in this repo satisfy
            the check, which defeats the point).
          </p>
          <CopyBlock language="shell" code={`cosign verify-attestation ${sampleRefVersioned} \\\n  --type spdxjson \\\n  --certificate-identity-regexp '${workflowIdentityRegex}' \\\n  --certificate-oidc-issuer '${oidcIssuer}' \\\n  | jq '.payload | @base64d | fromjson | .predicate'`} />
        </section>

        <section class="space-y-3">
          <h3 class="heading text-base text-ink-50">4. Verify SLSA L3 provenance</h3>
          <p class="text-sm text-ink-200">
            Confirms the build provenance was produced by the configured upstream
            slsa-github-generator running on hosted GitHub runners, from the protected release
            branch. The image tag and manifest digest still pin the released artifact.
          </p>
          <CopyBlock language="shell" code={`# Resolve the multi-arch digest first\nDIGEST=$(crane digest ${sampleRefVersioned})\nslsa-verifier verify-image ${sampleRegistryBase}/${sampleImageName}@$DIGEST \\\n  --source-uri 'github.com/${ownerRepo}' \\\n  --source-branch 'main'`} />
        </section>

        <section class="space-y-3">
          <h3 class="heading text-base text-ink-50">5. Verify with the GitHub CLI (alternative to cosign)</h3>
          <p class="text-sm text-ink-200">
            The same build provenance is also published as a GitHub-native attestation.
            If you'd rather not run cosign, <code class="font-mono text-ink-100">gh attestation
            verify</code> checks it against GitHub's attestation store and the Sigstore
            public-good transparency log — pinning the repository, workflow identity, and source
            ref so only attestations produced by the release workflow are trusted.
          </p>
          <CopyBlock language="shell" code={`# Resolve the digest, then verify the GitHub-native attestation\nDIGEST=$(crane digest ${sampleRefVersioned})\ngh attestation verify oci://${sampleRegistryBase}/${sampleImageName}@$DIGEST \\\n  --repo ${ownerRepo} \\\n  --cert-identity-regex '${workflowIdentityRegex}' \\\n  --source-ref refs/heads/main`} />
        </section>

        <section class="space-y-3">
          <h3 class="heading text-base text-ink-50">6. Enforce at admission</h3>
          <p class="text-sm text-ink-200">
            For Kubernetes, every image detail page exposes a copy-pasteable Kyverno
            <code class="font-mono text-ink-100">ClusterPolicy</code> that wires the same
            certificate identity and issuer into a cluster-side admission gate. The policy uses
            a literal subject (not a regex) for an exact pin.
          </p>
        </section>
      </article>
    </div>
    </>)}
  </div>

  {!importedMode && <script is:inline>
    (function () {
      const triggers = document.querySelectorAll('[data-tab-trigger]');
      const panels = document.querySelectorAll('[data-tab-panel]');
      
      const setTab = (activeId) => {
        const knownIds = Array.from(triggers).map((btn) => btn.getAttribute('data-tab-trigger'));
        if (!knownIds.includes(activeId)) activeId = 'architecture';
        triggers.forEach((btn) => {
          const id = btn.getAttribute('data-tab-trigger');
          if (id === activeId) {
            btn.className = "flex items-center gap-1.5 rounded-full px-5 py-2.5 font-medium uppercase tracking-wider transition-all select-none hover:text-ink-50 text-accent-soft bg-accent/15 border border-accent/20";
            btn.setAttribute('aria-selected', 'true');
            btn.tabIndex = 0;
          } else {
            btn.className = "flex items-center gap-1.5 rounded-full px-5 py-2.5 font-medium uppercase tracking-wider text-ink-300 transition-all select-none hover:text-ink-50 border border-transparent";
            btn.setAttribute('aria-selected', 'false');
            btn.tabIndex = -1;
          }
        });
        panels.forEach((p) => {
          const id = p.getAttribute('data-tab-panel');
          if (id === activeId) {
            p.classList.remove('hidden');
            p.classList.add('space-y-8');
            p.setAttribute('aria-hidden', 'false');
          } else {
            p.classList.add('hidden');
            p.classList.remove('space-y-8');
            p.setAttribute('aria-hidden', 'true');
          }
        });
      };

      // Set active tab based on query param or default
      const params = new URLSearchParams(window.location.search);
      const initialTab = params.get('tab') || 'architecture';
      setTab(initialTab);

      triggers.forEach((btn, index) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-tab-trigger');
          setTab(id);
          // Update URL without reloading
          const url = new URL(window.location);
          url.searchParams.set('tab', id);
          window.history.replaceState({}, '', url);
        });
        btn.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
          event.preventDefault();
          const last = triggers.length - 1;
          let next = index;
          if (event.key === 'ArrowLeft') next = index === 0 ? last : index - 1;
          if (event.key === 'ArrowRight') next = index === last ? 0 : index + 1;
          if (event.key === 'Home') next = 0;
          if (event.key === 'End') next = last;
          const nextBtn = triggers[next];
          const nextId = nextBtn.getAttribute('data-tab-trigger');
          setTab(nextId);
          nextBtn.focus();
        });
      });
    })();
  </script>}
</Base>
