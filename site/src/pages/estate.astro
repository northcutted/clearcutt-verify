---
import Base from '../layouts/Base.astro';
import CopyBlock from '../components/CopyBlock.astro';
import { loadGraph, loadHistory, provenBreakdown, shortRef, METHOD_LABELS, coverage, proofShare, trendOf } from '../lib/estate';

const graph = loadGraph();
const history = loadHistory();
const series = history?.entries ?? [];
const firstSnapshot = series.length > 1 ? series[0] : null;
const lastSnapshot = series.length > 1 ? series[series.length - 1] : null;
const trendRows = firstSnapshot && lastSnapshot
  ? [
      { label: 'Images observed', from: firstSnapshot.metrics.images, to: lastSnapshot.metrics.images, higherIsBetter: true },
      { label: 'Provenance resolved', from: firstSnapshot.metrics.resolved, to: lastSnapshot.metrics.resolved, higherIsBetter: true },
      { label: 'Proven by layer digests', from: firstSnapshot.metrics.proven, to: lastSnapshot.metrics.proven, higherIsBetter: true },
      { label: 'Consumers on a stale base', from: firstSnapshot.metrics.stale, to: lastSnapshot.metrics.stale, higherIsBetter: false },
    ].map((row) => ({ ...row, ...trendOf(row.from, row.to, row.higherIsBetter) }))
  : [];
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';

const proof = graph ? provenBreakdown(graph) : null;
const stale = graph
  ? [...graph.edges]
      .filter((e) => e.drift === 'stale')
      .sort((a, b) => b.versionsBehind - a.versionsBehind || a.consumerRef.localeCompare(b.consumerRef))
  : [];
const methodRows = graph
  ? Object.keys(METHOD_LABELS)
      .map((id) => ({ id, count: graph.summary.edgesByMethod[id] ?? 0, ...METHOD_LABELS[id] }))
  : [];

const scanCommands = `clearcutt-verify registry scan \\
  --registry ghcr.io --namespace YOUR_ORG/YOUR_REPO \\
  --repository YOUR_BASE_IMAGE --repository YOUR_APP_IMAGE \\
  --output dist/scan/images.yaml

clearcutt-verify import observe \\
  --images dist/scan/images.yaml --output dist/scan/observations.json

clearcutt-verify graph build \\
  --observations dist/scan/observations.json \\
  --output dist/scan/graph.json --report dist/scan/inventory.md`;
---
<Base title="Estate" description="Which images are built on what, how stale each one is, and how every relationship was established.">
  <div class="space-y-10">
    <header class="space-y-3 border-b border-ink-800/40 pb-5">
      <p class="text-xs font-bold uppercase tracking-[0.22em] text-accent-soft">Governance inventory</p>
      <h1 class="heading text-3xl font-bold">Estate</h1>
      <p class="max-w-3xl text-xs sm:text-sm text-ink-300">
        Which images are built on what, how far each consumer has drifted from its base, and — for every relationship — whether it is proven or taken on the word of whoever built the image.
      </p>
      {graph && <p class="text-[11px] font-mono text-ink-400">Scanned {graph.generatedAt}</p>}
    </header>

    {!graph && (
      <section class="space-y-4 rounded-lg border border-ink-700/50 bg-ink-900/30 p-6">
        <h2 class="heading text-lg text-ink-50">No estate scan yet</h2>
        <p class="max-w-3xl text-sm text-ink-300">
          This page renders artifacts produced by a CLI run. Nothing here needs ClearCutt to have built the images — point it at any registry. Then rebuild the site with <code>--graph dist/scan/graph.json</code>.
        </p>
        <CopyBlock language="shell" code={scanCommands} />
      </section>
    )}

    {graph && (
      <>
        <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
          {[
            { label: 'Images observed', value: graph.summary.observedImages },
            { label: 'Base families', value: graph.summary.baseFamilies },
            { label: 'On current base', value: graph.summary.currentConsumers },
            { label: 'On a stale base', value: graph.summary.staleConsumers, warn: graph.summary.staleConsumers > 0 },
            { label: 'Base undetermined', value: graph.summary.unresolvedConsumers, warn: graph.summary.unresolvedConsumers > 0 },
          ].map((tile) => (
            <div class={`rounded-lg border p-4 ${tile.warn ? 'border-amber-500/40 bg-amber-500/5' : 'border-ink-800/40 surface-soft'}`}>
              <p class="text-2xl font-bold font-mono text-ink-50">{tile.value}</p>
              <p class="mt-1 text-[11px] uppercase tracking-wider text-ink-400">{tile.label}</p>
            </div>
          ))}
        </section>


        {series.length > 0 && (
          <section class="space-y-4">
            <h2 class="heading text-xl text-ink-50">Over time</h2>
            <p class="max-w-3xl text-xs sm:text-sm text-ink-300">
              Each snapshot is stored in the registry as an OCI artifact, and the series is an index over them. The numbers below come from that index's annotations, so reading this trend pulls no snapshot data at all — however long the history gets.
            </p>

            <div class="overflow-x-auto">
              <table class="w-full min-w-[34rem] border-collapse text-left text-xs sm:text-sm">
                <thead>
                  <tr class="border-b border-ink-700/50 text-[11px] uppercase tracking-[0.14em] text-ink-400">
                    <th class="py-2 pr-4 font-semibold">Snapshot</th>
                    <th class="py-2 pr-4 font-semibold">Images</th>
                    <th class="py-2 pr-4 font-semibold">Resolved</th>
                    <th class="py-2 pr-4 font-semibold">Proven</th>
                    <th class="py-2 pr-4 font-semibold">Coverage</th>
                    <th class="py-2 font-semibold">Proof share</th>
                  </tr>
                </thead>
                <tbody>
                  {series.map((entry) => (
                    <tr class="border-b border-ink-800/40">
                      <td class="py-2 pr-4 font-mono text-[11px] text-ink-200">{entry.generatedAt || 'untimed'}</td>
                      <td class="py-2 pr-4 text-ink-200">{entry.metrics.images}</td>
                      <td class="py-2 pr-4 text-ink-200">{entry.metrics.resolved}</td>
                      <td class="py-2 pr-4 text-ink-200">{entry.metrics.proven}</td>
                      <td class="py-2 pr-4 text-ink-200">{Math.round(coverage(entry.metrics) * 100)}%</td>
                      <td class="py-2 text-ink-200">{Math.round(proofShare(entry.metrics) * 100)}%</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {trendRows.length > 0 && (
              <div class="grid gap-3 sm:grid-cols-2">
                {trendRows.map((row) => (
                  <div class="rounded-lg border border-ink-700/50 bg-ink-900/30 p-4">
                    <p class="text-[11px] uppercase tracking-[0.14em] text-ink-400">{row.label}</p>
                    <p class="mt-1 font-mono text-sm text-ink-100">
                      {row.from} → {row.to}
                      <span class={
                        row.direction === 'improved'
                          ? 'ml-2 text-emerald-400'
                          : row.direction === 'regressed'
                            ? 'ml-2 text-amber-400'
                            : 'ml-2 text-ink-400'
                      }>
                        {row.delta > 0 ? `+${row.delta}` : row.delta} {row.direction}
                      </span>
                    </p>
                  </div>
                ))}
              </div>
            )}

            {series.length === 1 && (
              <p class="text-xs text-ink-400">One snapshot so far. A trend needs at least two.</p>
            )}
            <p class="max-w-3xl text-[11px] text-ink-400">
              Coverage is the share of consumers whose base is known at all. Proof share is the share of <em>those</em> resting on layer evidence rather than a label the image's own author wrote — anyone can raise coverage by labelling their own images, so proof share is the one that has to be earned.
            </p>
          </section>
        )}

        <section class="space-y-4">
          <h2 class="heading text-xl text-ink-50">How each relationship was established</h2>
          <p class="max-w-3xl text-sm text-ink-300">
            Only layer-digest matching is proof: it compares content, so it holds regardless of what an image claims about itself. Every other method reads a label or build record the image's own author wrote.
          </p>
          {proof && (
            <p class="text-sm text-ink-200">
              <strong class="text-ink-50 font-mono">{proof.proven}</strong> of{' '}
              <strong class="text-ink-50 font-mono">{graph.summary.resolvedConsumers}</strong> relationship{graph.summary.resolvedConsumers === 1 ? '' : 's'} proven by layer digests;{' '}
              <strong class="text-ink-50 font-mono">{proof.claimed}</strong> rest on self-reported metadata.
            </p>
          )}
          <div class="overflow-x-auto">
            <table class="w-full min-w-[46rem] text-left text-xs">
              <thead class="text-ink-400 uppercase tracking-wider">
                <tr><th class="py-2 pr-4">Method</th><th class="py-2 pr-4 text-right">Edges</th><th class="py-2 pr-4">Strength</th><th class="py-2">What it means</th></tr>
              </thead>
              <tbody class="font-sans text-ink-200">
                {methodRows.map((row) => (
                  <tr class="border-t border-ink-800/40">
                    <td class="py-2 pr-4 font-mono text-ink-100">{row.label}</td>
                    <td class="py-2 pr-4 text-right font-mono">{row.count}</td>
                    <td class="py-2 pr-4">
                      <span class={`chip ${row.strength === 'proof' ? 'border-emerald-500/40 text-emerald-300' : 'border-ink-600/60'}`}>{row.strength}</span>
                    </td>
                    <td class="py-2 text-ink-300">{row.meaning}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="space-y-4">
          <h2 class="heading text-xl text-ink-50">Base families</h2>
          {graph.bases.length === 0 ? (
            <p class="text-sm text-ink-300">No base family had an observed consumer.</p>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full min-w-[46rem] text-left text-xs">
                <thead class="text-ink-400 uppercase tracking-wider">
                  <tr><th class="py-2 pr-4">Repository</th><th class="py-2 pr-4 text-right">Versions</th><th class="py-2 pr-4">Current</th><th class="py-2 pr-4 text-right">Consumers</th><th class="py-2 text-right">Stale</th></tr>
                </thead>
                <tbody class="font-mono text-ink-200">
                  {graph.bases.map((b) => (
                    <tr class="border-t border-ink-800/40">
                      <td class="py-2 pr-4 text-ink-100">{b.repository}</td>
                      <td class="py-2 pr-4 text-right">{b.versions}</td>
                      <td class="py-2 pr-4 text-ink-300">{shortRef(b.currentRef)}</td>
                      <td class="py-2 pr-4 text-right">{b.consumers}</td>
                      <td class={`py-2 text-right ${b.staleConsumers > 0 ? 'text-amber-300' : ''}`}>{b.staleConsumers}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
          {graph.bases.flatMap((b) => (b.warnings ?? []).map((w) => (
            <p class="text-[11px] text-amber-300/90"><span class="font-mono">{b.repository}</span>: {w}</p>
          )))}
        </section>

        <section class="space-y-4">
          <h2 class="heading text-xl text-ink-50">Consumers on a stale base</h2>
          {stale.length === 0 ? (
            <p class="text-sm text-ink-300">Every consumer with a resolved base is on that base's current version.</p>
          ) : (
            <>
              <p class="max-w-3xl text-sm text-ink-300">
                The rebase candidates. Versions and days behind are measured against the newest version of the same base repository <em>observed in this scan</em>, not against upstream.
              </p>
              <div class="overflow-x-auto">
                <table class="w-full min-w-[52rem] text-left text-xs">
                  <thead class="text-ink-400 uppercase tracking-wider">
                    <tr><th class="py-2 pr-4">Consumer</th><th class="py-2 pr-4">Base</th><th class="py-2 pr-4">On</th><th class="py-2 pr-4">Current</th><th class="py-2 pr-4 text-right">Behind</th><th class="py-2 pr-4 text-right">Days</th><th class="py-2">Established by</th></tr>
                  </thead>
                  <tbody class="font-mono text-ink-200">
                    {stale.map((e) => (
                      <tr class="border-t border-ink-800/40">
                        <td class="py-2 pr-4 text-ink-100">{shortRef(e.consumerRef)}</td>
                        <td class="py-2 pr-4 text-ink-300">{e.baseRepository}</td>
                        <td class="py-2 pr-4">{shortRef(e.baseRef)}</td>
                        <td class="py-2 pr-4 text-ink-300">{shortRef(e.currentBaseRef ?? '')}</td>
                        <td class="py-2 pr-4 text-right text-amber-300">{e.versionsBehind}</td>
                        <td class="py-2 pr-4 text-right">{e.daysBehind || '—'}</td>
                        <td class="py-2"><span class="chip border-ink-600/60">{METHOD_LABELS[e.method]?.strength ?? e.method}</span></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          )}
        </section>

        {graph.unresolved.length > 0 && (
          <section class="space-y-3">
            <h2 class="heading text-xl text-ink-50">Base could not be determined</h2>
            <p class="max-w-3xl text-sm text-ink-300">
              Audit findings, not omissions. ClearCutt could not establish what these images are built on from the evidence available.
            </p>
            <ul class="space-y-2">
              {graph.unresolved.map((u) => (
                <li class="rounded border border-ink-800/40 surface-soft p-3">
                  <p class="font-mono text-xs text-ink-100">{u.consumerRef}</p>
                  <p class="mt-1 text-[11px] text-ink-400">{u.reasons.join('; ')}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="space-y-2 rounded-lg border border-ink-700/50 bg-ink-900/30 p-5">
          <h2 class="text-xs font-bold uppercase tracking-[0.22em] text-accent-soft">What this does not prove</h2>
          <ul class="ml-4 list-disc space-y-1 text-xs text-ink-300">
            <li>A layer-digest edge proves the consumer contains the base's layers. It does not prove that base was intended, nor that either image is signed, scanned, or fit for production.</li>
            <li>A declared, assisted or weak edge rests on metadata the image's author supplied. Treat it as a claim to verify.</li>
            <li>Currency is measured against the newest version observed in this scan. A base family that is itself out of date will still report its consumers current.</li>
            <li>No CVE, signature, SBOM or provenance conclusion is drawn here. See <a class="text-accent-soft hover:underline" href={`${base}catalog`}>the catalog</a> for evidence per image.</li>
          </ul>
        </section>
      </>
    )}
  </div>
</Base>
