---
import '../styles/global.css';
import '../styles/theme.css';
import { loadIndex } from '../lib/catalog';
import { accentStyle, loadSiteConfig } from '../lib/site-config';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  noIndex?: boolean;
}

const { title, description, noIndex } = Astro.props;
let index;
try { index = loadIndex(); } catch { index = null; }

const siteConfig = loadSiteConfig();
const nav = siteConfig.site.navigation;
const fullTitle = title ? `${title} · ${siteConfig.site.title}` : siteConfig.site.title;
const desc = description ?? siteConfig.site.description;
const base = (import.meta.env.BASE_URL ?? '/').replace(/\/$/, '') + '/';
const url = base;
const themeStyle = accentStyle(siteConfig);
const configuredLogo = siteConfig.site.logo;
const logoSrc = configuredLogo
  ? configuredLogo.startsWith('http://') || configuredLogo.startsWith('https://') || configuredLogo.startsWith('/')
    ? configuredLogo
    : `${base}${configuredLogo.replace(/^\.\//, '')}`
  : '';
const siteLinks = siteConfig.site.links;
const sourceHref = siteLinks.sourceRepo || index?.repoUrl;
const registryHref = siteLinks.registry || (index?.registryBase ? `https://${index.registryBase}` : '');
const sourceLabel = index ? `${index.owner}/${index.repo}` : 'Source';
const isReferenceSite = !index || (index.owner === 'northcutted' && index.repo === 'clearcutt');
const catalogSubtitle = index ? (isReferenceSite ? 'Reference Catalog' : `Catalog for ${sourceLabel}`) : 'Evidence Catalog';
const footerLinks = [
  sourceHref && { label: 'Source', href: sourceHref },
  registryHref && { label: 'Registry', href: registryHref },
  siteLinks.docs && { label: 'Docs', href: siteLinks.docs },
  siteLinks.support && { label: 'Support', href: siteLinks.support },
].filter(Boolean) as Array<{ label: string; href: string }>;
---
<!doctype html>
<html lang="en" style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      FOUC-prevention: resolves the user's theme synchronously before the
      stylesheet renders so we never flash light-on-dark or dark-on-light.
      Reads explicit preference from localStorage('theme'); falls back to
      `prefers-color-scheme`. Kept tiny and dependency-free on purpose.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var dark = stored === 'dark' || (stored !== 'light' && systemDark);
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noIndex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {/* theme-color matches Catppuccin Latte Base for light OS preference
        and Mocha Base for dark. The FOUC script will sync `.dark` on
        <html> before paint when the user has an explicit preference. */}
    <meta name="theme-color" content="#eff1f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1e1e2e" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@200..800&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet" />
  </head>
  <body class="font-sans">
    <header class="sticky top-0 z-30 border-b border-ink-800/80 bg-ink-950/85 backdrop-blur">
      <div class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-4 lg:flex-row lg:items-center lg:justify-between">
        <a href={url} class="group flex items-center gap-3 no-underline">
          {logoSrc ? (
            <img src={logoSrc} alt="" class="h-9 w-9 rounded-xl border border-accent/30 object-contain bg-ink-900" />
          ) : (
            <span class="relative inline-flex h-9 w-9 items-center justify-center rounded-xl border border-accent/30 bg-gradient-to-br from-accent/15 via-ink-800 to-ink-900 text-accent-soft">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 7l8-4 8 4-8 4-8-4z"/>
                <path d="M4 12l8 4 8-4"/>
                <path d="M4 17l8 4 8-4"/>
              </svg>
            </span>
          )}
          <div class="leading-tight">
            <div class="text-sm font-semibold text-ink-50">{siteConfig.site.title}</div>
            <div class="text-[11px] uppercase tracking-[0.18em] text-ink-300">
              {catalogSubtitle}
            </div>
          </div>
        </a>
        <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-sans font-medium">
          {nav.showHome && <a href={base} class="text-ink-200 hover:text-ink-50 transition">Home</a>}
          {nav.showEstate !== false && <a href={`${base}estate`} class="text-ink-200 hover:text-ink-50 transition">Estate</a>}
          <a href={`${base}catalog`} class="text-ink-200 hover:text-ink-50 transition">Catalog</a>
          {nav.showGettingStarted && <a href={`${base}getting-started`} class="text-ink-200 hover:text-ink-50 transition">Containerize your app</a>}
          {nav.showAuditGuide && <a href={`${base}about?tab=audit`} class="text-ink-200 hover:text-ink-50 transition">Verify evidence</a>}
          {nav.showCliDocs && <a href={`${base}cli`} class="text-ink-200 hover:text-ink-50 transition">CLI</a>}
          <a href={`${base}limitations`} class="text-ink-200 hover:text-ink-50 transition">Limitations</a>
          {siteLinks.docs && <a href={siteLinks.docs} class="text-ink-200 hover:text-ink-50 transition" target="_blank" rel="noreferrer">Docs</a>}
          {siteLinks.support && <a href={siteLinks.support} class="text-ink-200 hover:text-ink-50 transition" target="_blank" rel="noreferrer">Support</a>}
          {sourceHref && (
            <a
              href={sourceHref}
              class="chip border-ink-600/60 hover:border-accent/40"
              target="_blank" rel="noreferrer"
            >
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.17-.89-1.17-.72-.5.05-.49.05-.49.8.06 1.22.83 1.22.83.71 1.21 1.87.86 2.33.66.07-.51.28-.86.5-1.06-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.66 7.66 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
              <span>{sourceLabel}</span>
            </a>
          )}
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main class="mx-auto max-w-7xl px-6 pb-24 pt-10">
      <slot />
    </main>
    <footer class="border-t border-ink-800/80 py-8 text-center text-xs text-ink-300">
      <div class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-6">
        {index ? (
          <p>
            This site renders catalog data for <span class="font-mono text-ink-200">{sourceLabel}</span>; ClearCutt is the generator. Catalog rebuilt {new Date(index.generatedAt).toUTCString()} ·
            <a href={sourceHref || index.repoUrl} class="ml-1 text-ink-200 hover:text-accent-soft" target="_blank" rel="noreferrer">
              source on GitHub
            </a>
          </p>
        ) : (
          <p>Run <code>clearcutt-verify catalog build</code> to populate the catalog.</p>
        )}
        {footerLinks.length > 0 && (
          <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2">
            {footerLinks.map((link) => (
              <a href={link.href} class="text-ink-200 hover:text-accent-soft" target="_blank" rel="noreferrer">
                {link.label}
              </a>
            ))}
          </nav>
        )}
      </div>
    </footer>
  </body>
</html>
